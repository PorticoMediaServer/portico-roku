{
  "auditTrace": [
    {
      "issue": "RK-31",
      "outcome": "Up Next publishes distinct title and visible countdown fields and does not republish an unchanged visible second."
    },
    {
      "issue": "RK-33",
      "outcome": "Valid viewer-scoped cached Library resources remain focusable while offline or stale."
    },
    {
      "issue": "RK-34",
      "outcome": "Library filters expose Clear Filters, derive focus only from visible actions, and reject hidden Apply activation."
    },
    {
      "issue": "RK-35",
      "outcome": "Saved mutation failure is visible on its initiating surface or through a focus-safe global notice."
    },
    {
      "issue": "RK-36",
      "outcome": "Permanent Library Channel unavailability has no retry affordance; transient failure may retry."
    },
    {
      "issue": "RK-37",
      "outcome": "Only lifecycle and active realtime or playback tasks remain resident; hidden domains do not short-poll."
    },
    {
      "issue": "RK-38",
      "outcome": "The player controller owns focus and remote keys; the native video node never owns focus."
    },
    {
      "issue": "RK-39",
      "outcome": "Fatal player actions are real focus targets and show Retry only when retry is truthful, plus Back to Details."
    },
    {
      "issue": "RK-40",
      "outcome": "Search-history deletion uses the same confirmation policy in Search and Settings."
    }
  ],
