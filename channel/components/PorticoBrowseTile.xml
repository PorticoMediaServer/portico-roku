        <field id="tileKind" type="string" value="facet" onChange="render" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/PorticoNodes.brs" />
    <script type="text/brightscript" uri="pkg:/components/PorticoBrowseTile.brs" />
    <children>
        <Poster id="surface" loadDisplayMode="scaleToFill" />
        <Label id="title0" maxLines="1" />
        <Label id="title1" maxLines="1" />
        <Label id="meta" maxLines="1" />
        <Label id="summary0" maxLines="1" />
        <Label id="summary1" maxLines="1" />
        <Label id="summary2" maxLines="1" />
    </children>
</component>
