{
  "name": "portico-roku",
  "version": "0.1.0",
  "private": true,
  "description": "Portico for Roku: a BrightScript and SceneGraph translation of the Apple TV app.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "lint:literals": "node scripts/lint-literals.mjs",
    "check": "npm run lint:literals && bsc --project bsconfig.json --copy-to-staging=false --create-package=false",
    "build": "bsc --project bsconfig.json",
    "package": "node scripts/package.mjs",
    "test": "node scripts/test.mjs",
    "fixtures:generate": "node scripts/golden.mjs",
    "generate:accounts": "node scripts/generate-accounts.mjs",
    "generate:transport": "node scripts/generate-transport.mjs",
    "generate:tv-signin": "node scripts/generate-tv-signin.mjs",
    "generate:channel-tint": "node scripts/generate-channel-tint.mjs",
    "generate:search-genres": "node scripts/generate-search-genres.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@rokucommunity/brs": "0.47.6",
    "brighterscript": "0.73.5",
    "brs-engine": "2.6.1",
    "brs-scenegraph": "0.6.2",
    "playwright-core": "1.56.1",
    "qrcode": "1.5.4",
    "roku-deploy": "3.18.4"
  }
}
