{
  "rootDir": ".",
  "files": [
    "manifest",
    "source/**/*",
    "components/**/*",
    "images/**/*",
    "fonts/**/*",
    "locale/**/*",
    "data/**/*"
  ],
  "stagingDir": "build/staging",
  "retainStagingDir": true,
  "createPackage": false,
  "autoImportComponentScript": true,
  "sourceMap": false,
  "emitDefinitions": false
}
