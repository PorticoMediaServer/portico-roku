' Requests a signed-in viewer makes, for Task threads: the saved session's bearer on the selected
' server, renewed once when the server refuses it (packages/client-core/src/index.ts
' `HttpLocalApi.exchange`, session-refresh.ts), and the small documents the shell reads
' (the library list).
import "pkg:/source/core/Session.bs"
import "pkg:/source/core/ClientProfile.bs"

' The api for the selected server with the viewer's token, or invalid when there is no sign-in.
function ViewerRequestBinding(viewer as dynamic) as dynamic
    if viewer = invalid or viewer.viewer = invalid then return invalid
    facts = viewer.viewer
    binding = { origin: viewer.origin, serverId: facts.serverId, accountId: facts.accountId, profileId: facts.profileId, authority: facts.authority }
    if IsText(viewer.sessionFamilyId, 128) then binding.sessionFamilyId = viewer.sessionFamilyId
    return binding
end function

function ViewerMatchesRequestBinding(record as dynamic, expected as dynamic) as boolean
    if expected = invalid then return true
    if record = invalid then return false
    facts = record["session"].viewer
    if expected.sessionFamilyId <> invalid and expected.sessionFamilyId <> record["session"].sessionFamilyId then return false
    return record["logicalOrigin"] = expected.origin and facts.serverId = expected.serverId and facts.accountId = expected.accountId and facts.profileId = expected.profileId and facts.authority = expected.authority
end function

function ViewerApi(ctx as object, expectedViewer = invalid as dynamic) as dynamic
    record = SessionRecord(ctx)
    if record = invalid or not ViewerMatchesRequestBinding(record, expectedViewer) then return invalid
    api = SessionApi(ctx, record["logicalOrigin"], record["session"].accessToken)
    api.ctx = ctx
    api.expectedViewer = expectedViewer
    api.renew = function(api as object, rejected as string) as dynamic
        record = SessionRecord(api.ctx)
        if record = invalid or not ViewerMatchesRequestBinding(record, api.expectedViewer) then return invalid
        ' Another request may already have renewed it.
        if record["session"].accessToken <> rejected then return record["session"].accessToken
        renewed = SessionRenew(api.ctx, record, rejected)
        if not renewed.ok then return invalid
        return renewed.session.accessToken
    end function
    return api
end function

' One request as the viewer: {ok, status, data, headers} or {ok: false, status, error}.
function ViewerRequest(ctx as object, path as string, method = "GET" as string, body = invalid as dynamic, extra = invalid as dynamic, expectedViewer = invalid as dynamic) as object
    api = ViewerApi(ctx, expectedViewer)
    if api = invalid then return { ok: false, status: 401, error: { status: 401, code: "session_expired", message: "", retryable: false } }
    return ApiRequest(api, path, method, body, extra)
end function

' Only requests that plan or start playback need a fresh output probe. Timeline acknowledgements,
' reads and queue edits keep their own transport and ordering.
function PlaybackNeedsCapabilities(path as string, method as string) as boolean
    if method = "GET" then return MatchesPattern(path, "^/v1/items/[^/]+/playback-options(?:\\?|$)")
    if method = "POST" then return path = "/v1/playback/sessions" or path = PlaybackRoutes.queue or MatchesPattern(path, "^/v1/queues/[^/]+:advance$")
    if method = "PATCH" then return MatchesPattern(path, "^/v1/playback/sessions/[^/]+$")
    return false
end function

function PublishDeviceCapabilities(ctx as object, expectedViewer as dynamic, facts as object) as object
    record = SessionRecord(ctx)
    api = ViewerApi(ctx, expectedViewer)
    if api = invalid then return { ok: false, status: 401, error: { code: "session_expired", status: 401, message: "", retryable: false } }
    family = record["session"].sessionFamilyId
    document = RokuCapabilityProfile(facts)
    digest = CryptoDigest("sha256", BytesFromText(FormatJson(document)))
    section = SessionRecordSection(record["pin"].serverId)
    fingerprint = ""
    if digest <> invalid then fingerprint = family + ":" + BytesToHex(digest)
    if fingerprint <> "" and ctx.store.read(section, "playbackCapabilities") = fingerprint then return { ok: true, status: 204, data: invalid, headers: {}, unchanged: true }
    answer = ApiRequest(api, PlaybackRoutes.capabilities, "PUT", document)
    if not answer.ok then return answer
    receipt = ParseCapabilityReceipt(answer)
    if receipt = invalid then return { ok: false, status: 0, error: { code: "invalid_response", status: 0, message: "", retryable: false } }
    current = SessionRecord(ctx)
    if current = invalid or not ViewerMatchesRequestBinding(current, expectedViewer) or current["session"].sessionFamilyId <> family then return { ok: false, status: 401, error: { code: "session_expired", status: 401, message: "", retryable: false } }
    if fingerprint <> "" then ctx.store.write(section, "playbackCapabilities", fingerprint)
    return answer
end function

' Actual ApiTask entry: publish the current sink facts before any planning request, then recheck
' the captured viewer. A late publication can never send a queue command as a different viewer.
function PlaybackViewerRequest(ctx as object, path as string, method = "GET" as string, body = invalid as dynamic, extra = invalid as dynamic, expectedViewer = invalid as dynamic) as object
    if expectedViewer = invalid then
        record = SessionRecord(ctx)
        if record <> invalid then expectedViewer = ViewerRequestBinding({ origin: record["logicalOrigin"], sessionFamilyId: record["session"].sessionFamilyId, viewer: record["session"].viewer })
    end if
    if PlaybackNeedsCapabilities(path, method) or (path = PlaybackRoutes.capabilities and method = "PUT") then
        published = PublishDeviceCapabilities(ctx, expectedViewer, DeviceFacts())
        if not published.ok or path = PlaybackRoutes.capabilities then return published
    end if
    return ViewerRequest(ctx, path, method, body, extra, expectedViewer)
end function

' packages/design/src/media-icons.ts `mediaFamilyIcon`: the icon of a library's family. Unknown
' kinds are explicit (invalid): callers must not silently relabel them as movies.
function MediaFamilyIcon(kind as dynamic) as dynamic
    icons = { "movie": "film", "tv": "tv", "anime": "tv", "audiobook": "book", "music": "music" }
    if Type(kind) <> "String" and Type(kind) <> "roString" then return invalid
    return icons[kind]
end function

' GET /v1/libraries: the libraries this viewer may open, in the server's order: [{id, name, kind}].
function ParseLibraries(data as dynamic) as object
    out = []
    if not IsObject(data) or not IsArray(FieldOf(data, "items")) then return out
    for each item in FieldOf(data, "items")
        if IsObject(item) and IsText(item.id, 256) and IsString(item.name) and IsString(item.kind) then out.push({ id: item.id, name: item.name, kind: item.kind })
    end for
    return out
end function
