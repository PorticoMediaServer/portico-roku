' Read-only account-move.ts consumer. This does not expose the web-only owner commands or add
' a TV Sign-in page. The server remains the authority for owner/main-profile access.
import "pkg:/source/core/Content.bs"

' Match the canonical Unicode Cc/Cf rejection on Roku and the off-device interpreter. Accept
' ordinary non-ASCII names; account for either UTF-16 pairs or a platform Unicode code point.
function IsSignInStatusText(value as dynamic, limit as integer, empty = false as boolean) as boolean
    if not IsString(value) then return false
    if value = "" then return empty
    units = 0
    index = 1
    ranges = SignInTextControlRanges()
    while index <= Len(value)
        point = Asc(Mid(value, index, 1))
        index = index + 1
        if point >= 55296 and point <= 56319 then
            if index > Len(value) then return false
            low = Asc(Mid(value, index, 1))
            if low < 56320 or low > 57343 then return false
            point = 65536 + (point - 55296) * 1024 + low - 56320
            index = index + 1
        else if point >= 56320 and point <= 57343 then
            return false
        end if
        units = units + 1
        if point > 65535 then units = units + 1
        if units > limit then return false
        for each span in ranges
            if point >= span[0] and point <= span[1] then return false
        end for
    end while
    return true
end function

function IsSignInStatusCount(value as dynamic) as boolean
    return IsNatural(value) and value <= 9007199254740991#
end function

function ParseSignInStatusMove(raw as dynamic) as dynamic
    if not IsObject(raw) or not IsSignInStatusText(raw.id, 128) or not IsSignInStatusText(raw.serverName, 120) then return invalid
    if not ArrayIncludes(["local", "portico"], raw.from) or not ArrayIncludes(["local", "portico"], raw.to) or raw.from = raw.to then return invalid
    if not IsBoolean(raw.startOver) or not ArrayIncludes(SignInMoveStages(), raw.stage) or not IsSignInStatusCount(raw.revision) or raw.revision < 1 then return invalid
    for each key in ["people", "profiles", "invitations", "waiting"]
        if not IsSignInStatusCount(raw[key]) then return invalid
    end for
    if raw.waiting > raw.people or not IsBoolean(raw.ownAddressRequired) or raw.ownAddressRequired <> (raw.to = "local") then return invalid
    if raw.stage = "moving_to_local" and raw.to <> "local" then return invalid
    if raw.stage = "moving_to_portico" and raw.to <> "portico" then return invalid
    if raw.startOver then
        if raw.doesExist("devices") then return invalid
    else
        if not IsSignInStatusCount(raw.devices) then return invalid
    end if
    move = { id: raw.id, from: raw.from, to: raw.to, startOver: raw.startOver, stage: raw.stage, revision: raw.revision, people: raw.people, profiles: raw.profiles, invitations: raw.invitations, waiting: raw.waiting, serverName: raw.serverName, ownAddressRequired: raw.ownAddressRequired }
    if not raw.startOver then move.devices = raw.devices
    return move
end function

function ParseSignInStatus(raw as dynamic) as object
    bad = SessionFailure("invalid_account_move")
    if not IsObject(raw) or not ArrayIncludes(["local", "portico"], raw.signIn) or not IsObject(raw.owner) or not raw.doesExist("move") then return bad
    if raw.webPath <> AccountRoutes.signInSettingsPath then return bad
    owner = raw.owner
    if not IsSignInStatusText(owner.accountId, 128) or not IsSignInStatusText(owner.username, 64) or not IsSignInStatusText(owner.displayName, 120, true) then return bad
    if owner.doesExist("email") and not IsSignInStatusText(owner.email, 254) then return bad
    move = invalid
    if raw.move <> invalid then
        move = ParseSignInStatusMove(raw.move)
        if move = invalid then return bad
        if move.stage = "moving_to_local" and raw.signIn <> "local" then return bad
        if move.stage = "moving_to_portico" and raw.signIn <> "portico" then return bad
    end if
    person = { accountId: owner.accountId, username: owner.username, displayName: owner.displayName }
    if owner.doesExist("email") then person.email = owner.email
    return { ok: true, settings: { signIn: raw.signIn, owner: person, move: move, webPath: raw.webPath } }
end function

' Mandatory capture includes the session family. Selection, profile replacement, sign-out and
' live capability loss retire the result even if the transport finished successfully.
function ReadOnlySignInNew(ctx as object, binding as dynamic) as dynamic
    if not IsObject(binding) then return invalid
    for each key in ["origin", "serverId", "accountId", "profileId", "authority", "sessionFamilyId"]
        if not IsText(binding[key], 300) then return invalid
    end for
    captured = {}
    captured.append(binding)
    client = { ctx: ctx, binding: captured, revision: SessionRevision(ctx), epoch: 0, disposed: false }
    client.cancel = sub()
        m.epoch = m.epoch + 1
    end sub
    client.dispose = sub()
        m.cancel()
        m.disposed = true
    end sub
    client.read = function() as object
        if not ReadOnlySignInCurrent(m) then return SessionFailure("cancelled")
        record = SessionRecord(m.ctx)
        if record["capabilities"].manageSignIn <> true then return SessionFailure("forbidden")
        m.cancel()
        epoch = m.epoch
        answer = ViewerRequest(m.ctx, AccountRoutes.signInStatus, "GET", invalid, invalid, m.binding)
        if epoch <> m.epoch or not ReadOnlySignInCurrent(m) then return SessionFailure("cancelled")
        record = SessionRecord(m.ctx)
        if not ViewerMatchesRequestBinding(record, m.binding) then return SessionFailure("cancelled")
        if record["capabilities"].manageSignIn <> true then return SessionFailure("cancelled")
        if not answer.ok then return { ok: false, failure: answer.error }
        return ParseSignInStatus(answer.data)
    end function
    return client
end function

function ReadOnlySignInCurrent(client as object) as boolean
    if client.disposed or client.revision <> SessionRevision(client.ctx) or not SessionAdmissionCurrent(client.ctx) then return false
    return ViewerMatchesRequestBinding(SessionRecord(client.ctx), client.binding)
end function
