' Quality and sleep tables retained from their original checked producers.

' playback-v1/quality.ts qualityLadder: the ceilings a viewer can choose, best first.
function PlaybackQualityLadder() as object
    return [{"height": 2160, "kbps": 40000}, {"height": 1440, "kbps": 20000}, {"height": 1080, "kbps": 8000}, {"height": 720, "kbps": 4000}, {"height": 480, "kbps": 1500}, {"height": 360, "kbps": 800}]
end function

' player/PlayerOptions.tsx: the sleep timer's choices, in minutes.
function PlayerSleepMinutes() as object
    return [15, 30, 45, 60]
end function
