' The Task owns private password/MFA continuation. This adapter supplies the credential
' callbacks: persist before publication, and retain exact issuing authority for revocation.
import "pkg:/source/core/HostedCredentials.bs"

function HostedRetirementValid(raw as dynamic, origin as string) as boolean
    if not IsObject(raw) or not HasExactKeys(raw, ["origin", "accountId", "familyId", "refreshToken"]) then return false
    return raw.origin = origin and MatchesPattern(raw.accountId, "^[A-Za-z0-9_-]{1,160}$") and MatchesPattern(raw.familyId, "^[A-Za-z0-9_-]{1,128}$") and IsText(raw.refreshToken, 16384)
end function

function HostedRetryRetirements(ctx as object, origin as string) as boolean
    scope = "portico.hosted.retirements"
    complete = true
    for each key in ctx.store.keys(scope)
        authority = StoreReadJson(ctx.store, scope, key)
        if HostedRetirementValid(authority, origin) then
            api = SessionApi(ctx, origin)
            api.timeoutMs = 3000
            answer = ApiRequest(api, AccountRoutes.porticoRevoke, "POST", { refreshToken: authority.refreshToken })
            if answer.ok then
                if not ctx.store.remove(scope, key) then complete = false
            else
                complete = false
            end if
        else
            ' An unknown or differently scoped record is preserved, never sent elsewhere.
            complete = false
        end if
    end for
    return complete
end function

function HostedCredentialOwnerNew(ctx as object) as dynamic
    origin = RouteOrigin(ctx.hostedUrl)
    if not origin.ok or origin.origin <> ctx.hostedUrl or Left(origin.origin, 8) <> "https://" then return invalid
    if HostedLoad(ctx) <> invalid or not SessionAdmissionCurrent(ctx) then return invalid
    owner = { ctx: ctx, origin: origin.origin, revision: SessionRevision(ctx), admitted: invalid }
    owner.isCurrent = function() as boolean
        if m.ctx.hostedUrl <> m.origin or SessionRevision(m.ctx) <> m.revision or not SessionAdmissionCurrent(m.ctx) then return false
        current = HostedLoad(m.ctx)
        return current = invalid or (m.admitted <> invalid and HostedSameGrant(current, m.admitted))
    end function
    owner.admitGrant = function(grant as object) as object
        if not m.isCurrent() or HostedLoad(m.ctx) <> invalid then return SessionFailure("account_changed")
        if not HostedSave(m.ctx, grant) then return SessionFailure("persistence_error")
        m.admitted = grant
        return { ok: true }
    end function
    owner.retireLateGrant = sub(grant as object)
        if not HostedGrantValid(grant) then return
        current = HostedLoad(m.ctx)
        if m.admitted <> invalid and HostedSameGrant(m.admitted, grant) and HostedSameGrant(current, grant) then
            m.ctx.store.remove("portico", "hosted")
        else if HostedSameGrant(current, grant) then
            ' Another attempt already admitted this exact idempotent grant.
            return
        end if
        authority = { origin: m.origin, accountId: grant.account.id, familyId: grant.familyId, refreshToken: grant.refreshToken }
        if StoreWriteJson(m.ctx.store, "portico.hosted.retirements", "family." + grant.familyId, authority) then
            HostedRetryRetirements(m.ctx, m.origin)
        else
            HostedRevokeCapturedGrant(m.ctx, m.origin, grant)
        end if
    end sub
    return owner
end function

function HostedCredentialOwnerComplete(owner as object, result as object) as object
    if not result.ok or result.kind <> "signed-in" then return result
    if not owner.isCurrent() or owner.admitted = invalid then
        if owner.admitted <> invalid then owner.retireLateGrant(owner.admitted)
        return SessionFailure("cancelled")
    end if
    if not owner.ctx.store.write("portico", "sessionRevision", (owner.revision + 1).toStr()) then
        owner.retireLateGrant(owner.admitted)
        return SessionFailure("persistence_error")
    end if
    return { ok: true, kind: "signed-in", account: owner.admitted.account, familyId: owner.admitted.familyId }
end function
