      "id": "signed-out",
      "state": {"accountStatus": "signed-out"},
      "expected": {"kind": "defer", "gate": "account"}
    },
    {
      "id": "server-not-ready",
      "state": {
        "accountStatus": "signed-in",
        "credentialsDurable": true,
        "serverStatus": "connecting",
        "selectedServerId": "server-a"
      },
      "expected": {"kind": "defer", "gate": "server"}
    },
    {
      "id": "profile-not-ready",
      "state": {
        "accountStatus": "signed-in",
