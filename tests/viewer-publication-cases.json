{
  "schemaVersion": 1,
  "foundation": {
    "navigationContractRevision": "v1",
    "semanticRevisions": {
      "externalAction": 1,
      "viewerProfileAuthority": 1
    }
  },
  "lifecycle": {
    "gates": ["account", "server", "profile"],
    "publicationRequires": [
      "durableCredentials",
      "routeGeneration",
      "authorizationRevision",
      "viewerGeneration"
    ],
    "deepLinkDelivery": "exactly-once-after-ack",
    "pendingTtlSeconds": 600,
    "corruption": "fail-closed"
  },
  "integrationHooks": [
    {
      "file": "channel/source/main.brs",
      "field": "externalRequest",
      "action": "PorticoLifecycleAcknowledgeDispatch",
      "status": "source-only",
      "owner": "SceneGraph integration lane"
    }
  ],
  "vectors": [
