<?xml version="1.0" encoding="utf-8"?>
<!-- One request as the signed-in viewer, off the render thread, with its answer parsed by the named reader. -->
<component name="ApiTask" extends="Task">
    <interface>
        <!-- {path, method, body, headers, reader, context}: `reader` names the parser the answer goes through. -->
        <!-- searchGenres uses window:{limit?,cursor?} and the exact expectedViewer captured by ApiStart. -->
        <field id="request" type="assocarray" />
        <!-- Cooperative cancellation for bounded reads; never shadows native Task state/control. -->
        <field id="cancelled" type="boolean" value="false" />
        <!-- {ok, status, value, error}: `value` is what the reader made of the answer. -->
        <field id="result" type="assocarray" />
        <!-- For readers that build a tree for a list: the content the screen hands straight to its list. -->
        <field id="content" type="node" />
    </interface>
</component>
