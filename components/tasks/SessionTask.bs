' Runs one session step in a Task thread and reports its result. The steps themselves, and what
' each returns, are in source/core/Session.bs and source/core/Hosted.bs.
import "pkg:/source/core/Session.bs"
import "pkg:/source/core/Hosted.bs"
import "pkg:/source/core/TVConsent.bs"
import "pkg:/source/core/SignInStatus.bs"
import "pkg:/source/core/MemberAccountMove.bs"
import "pkg:/source/core/IdentityRecovery.bs"

sub init()
    m.top.functionName = "work"
end sub

sub work()
    job = m.top.job
    ctx = SessionContextNew()
    result = { ok: false, failure: { code: "invalid_request", status: 0, message: "" } }
    kind = job.kind
    if kind = "signIn" or kind = "challenge" or kind = "changePassword" or kind = "chooseProfile" or kind = "openServer" then
        if not IsNatural(job.expectedRevision) then
            result.kindOfJob = kind
            m.top.job = { kind: kind }
            m.top.result = result
            return
        end if
        ctx.admissionRevision = job.expectedRevision
        ctx.task = m.top
        if not SessionAdmissionCurrent(ctx) then
            result = SessionFailure("cancelled")
            result.kindOfJob = kind
            m.top.job = { kind: kind }
            m.top.result = result
            return
        end if
    end if
    if kind = "retryIdentity" then
        result = IdentityRecoveryRetry(ctx, job.recovery)
        result.source = job.recovery.source
        result.recovery = job.recovery
        result.recoverySerial = job.recoverySerial
    else if kind = "forgetIdentity" then
        result = IdentityRecoveryForget(ctx, job.recovery)
        result.recoverySerial = job.recoverySerial
    else if kind = "movePassword" or kind = "moveCodePreview" or kind = "moveRedeemLocal" or kind = "moveRedeemPortico" then
        ctx.task = m.top
        mover = MemberAccountMoveNew(ctx, job.connection, MemberMoveTaskOptions(ctx, job.connection, job.expectedRevision))
        if mover <> invalid then
            if kind = "movePassword" then
                result = mover.password(job.username, job.password)
            else if kind = "moveCodePreview" then
                result = mover.previewCode(job.code)
            else if kind = "moveRedeemLocal" then
                result = mover.redeemLocal(job.code, job.username, job.password)
            else
                result = mover.redeemPortico(job.proof, job.porticoIdentity)
            end if
            mover.dispose()
        end if
        m.top.job = { kind: kind }
    else if kind = "readSignInStatus" then
        ctx.task = m.top
        reader = invalid
        if IsNatural(job.expectedRevision) then
            ctx.admissionRevision = job.expectedRevision
            reader = ReadOnlySignInNew(ctx, job.viewerBinding)
        end if
        if reader <> invalid then
            result = reader.read()
            reader.dispose()
        end if
    else if kind = "reviewTVConsent" then
        result = TVConsentReview(ctx, job.authorityKind, job.code)
    else if kind = "decideTVConsent" then
        result = TVConsentDecide(ctx, job.reviewed, job.decision)
    else if kind = "cancelTVConsent" then
        TVConsentCancel(ctx)
        result = { ok: true }
    else if kind = "restore" then
        result = SessionRestore(ctx)
        result.hosted = HostedLoad(ctx)
    else if kind = "connect" then
        result = SessionConnect(ctx, job.address, job.pin)
    else if kind = "signIn" then
        result = SessionSignIn(ctx, job.connection, job.username, job.password)
    else if kind = "challenge" then
        result = SessionCompleteChallenge(ctx, job.connection, job.token, job.code, job.username)
    else if kind = "changePassword" then
        result = SessionChangeRequiredPassword(ctx, job.connection, job.accountSession, job.currentPassword, job.newPassword)
        ' The password just set is the current one: sign in again with it.
        if result.ok then result = SessionSignIn(ctx, job.connection, job.username, job.newPassword)
    else if kind = "chooseProfile" then
        result = SessionChooseProfile(ctx, job.connection, job.pending, job.profileId, job.pin, job.details)
    else if kind = "profiles" then
        result = SessionProfiles(ctx, job.connection, job.token)
    else if kind = "accountNotices" then
        result = HostedAccountNotices(ctx, job.ask)
        result.asked = job.ask.kind
    else if kind = "avatars" then
        result = SessionAvatars(ctx, job.connection, job.token)
    else if kind = "signOut" then
        result = SessionSignOut(ctx, job.serverId, job.familyId)
    else if kind = "servers" then
        result = HostedServers(ctx)
        result.lastServer = ctx.store.read("portico", "lastHostedServer")
    else if kind = "openServer" then
        result = HostedOpen(ctx, job.server)
    else if kind = "selectServer" then
        result = SessionSelect(ctx, job.serverId)
    else if kind = "savedServers" then
        records = []
        for each record in SessionRecords(ctx)
            records.push({ serverId: record["pin"].serverId, serverName: record["serverName"], origin: record["logicalOrigin"], signIn: record["signIn"] })
        end for
        result = { ok: true, records: records }
    else if kind = "signOutAccount" then
        HostedSignOut(ctx, job.accountId)
        result = { ok: true, record: SessionRecord(ctx) }
    end if
    result.kindOfJob = kind
    if kind = "signIn" or kind = "challenge" or kind = "changePassword" then m.top.job = { kind: kind }
    if job.doesExist("recoverySerial") then result.recoverySerial = job.recoverySerial
    m.top.result = result
end sub
