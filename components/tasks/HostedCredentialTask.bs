import "pkg:/source/core/HostedCredentialOwner.bs"

sub init()
    m.top.functionName = "work"
end sub

sub work()
    ctx = SessionContextNew()
    ctx.admissionRevision = SessionRevision(ctx)
    ctx.task = m.top
    owner = HostedCredentialOwnerNew(ctx)
    if owner = invalid then
        m.top.outcome = SessionFailure("account_changed")
        return
    end if
    if not HostedRetryRetirements(ctx, owner.origin) then
        m.top.outcome = SessionFailure("revocation_pending")
        return
    end if
    client = HostedCredentialsNew(ctx, HostedCredentialContinuation(), owner)
    if client = invalid then return
    port = CreateObject("roMessagePort")
    m.top.observeField("submission", port)
    m.top.observeField("command", port)
    m.top.credentialState = { phase: "idle" }
    while owner.isCurrent()
        message = wait(1000, port)
        if message <> invalid and message.getField() = "submission" then
            input = message.getData()
            message = invalid
            m.top.submission = invalid
            if IsObject(input) then
                m.top.credentialState = { phase: "working" }
                answer = SessionFailure("invalid_request")
                if input.kind = "login" then
                    answer = client.login(input.username, input.password, NewRequestId())
                else if input.kind = "mfa" then
                    answer = client.mfa(input.factor)
                end if
                input = invalid
                answer = HostedCredentialOwnerComplete(owner, answer)
                if answer.ok and answer.kind = "signed-in" then
                    owner.revision = SessionRevision(ctx)
                    ctx.admissionRevision = owner.revision
                    ' Keep the private captured grant until the scene accepts this exact Task.
                    ' Leaving before delivery sends stop; a delayed event cannot strand it.
                    deadline = HostedCredentialAcceptanceDeadline(ctx)
                    m.top.credentialState = { phase: "awaiting-accept", acceptBySeconds: deadline }
                    m.top.outcome = answer
                    while true
                        ' The current scene's acknowledgement commits delivery. Later directory
                        ' or server admissions may legitimately advance the session revision.
                        if m.top.command = "accept" then return
                        if not owner.isCurrent() or SessionNow(ctx) >= deadline then exit while
                        wait(1000, port)
                    end while
                    m.top.credentialState = { phase: "retiring" }
                    owner.retireLateGrant(owner.admitted)
                    m.top.outcome = SessionFailure("cancelled")
                    return
                else if answer.ok and answer.kind = "challenge" then
                    m.top.credentialState = { phase: "challenge", expiresAt: answer.expiresAt }
                else
                    m.top.credentialState = { phase: "error", failure: answer.failure }
                    if client.disposed then
                        m.top.outcome = answer
                        return
                    end if
                end if
            end if
        end if
    end while
    client.dispose()
    m.top.submission = invalid
    m.top.outcome = SessionFailure("cancelled")
end sub
