<?xml version="1.0" encoding="utf-8"?>
<!-- One step of signing in or coming back, run off the render thread (core/Session.bs, core/Hosted.bs). -->
<component name="SessionTask" extends="Task">
    <interface>
        <!-- {kind, …}: restore | connect | signIn | challenge | changePassword | chooseProfile | profiles | signOut | servers | openServer | signOutAccount -->
        <field id="job" type="assocarray" />
        <field id="result" type="assocarray" />
    </interface>
</component>
