<?xml version="1.0" encoding="utf-8"?>
<component name="HostedCredentialTask" extends="Task">
    <interface>
        <!-- Passwords/factors are consumed and cleared. The continuation and MFA token stay on this Task. -->
        <field id="submission" type="assocarray" alwaysNotify="true" />
        <field id="command" type="string" value="" alwaysNotify="true" />
        <field id="credentialState" type="assocarray" />
        <!-- Only a durably admitted account summary and family ID, never access/refresh/challenge tokens. -->
        <field id="outcome" type="assocarray" />
    </interface>
</component>
