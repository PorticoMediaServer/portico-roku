' setup-code.ts: durable TV sign-in consent. Device secrets stay on this Task thread.
import "pkg:/source/core/SetupJournal.bs"

sub init()
    m.top.functionName = "work"
end sub

sub work()
    ctx = SessionContextNew()
    ctx.admissionRevision = SessionRevision(ctx)
    ctx.task = m.top
    port = CreateObject("roMessagePort")
    m.top.observeField("command", port)
    account = m.top.mode = "account"
    connection = m.top.connection
    ctx.setupOrigin = ctx.hostedUrl
    if not account then
        if not SessionRequiresLocal(connection).ok then return
        ctx.setupOrigin = connection.origin
    end if
    scope = SetupJournalScope(ctx, account, connection)
    current = SetupReceipt(ctx, scope, "current")
    authorization = invalid
    nextPoll = 0
    if current <> invalid then
        authorization = current.authorization
        if current.nextPollAt <> invalid then nextPoll = current.nextPollAt
    end if
    failures = 0
    createAfter = 0
    cleanupAfter = 0
    halted = false
    m.top.state = SetupTaskState(authorization)
    while true
        now = NowSeconds()
        if not SessionAdmissionCurrent(ctx) then
            SetupJournalAbandon(ctx, scope, account, connection)
            return
        end if
        if now >= cleanupAfter then
            SetupJournalCleanup(ctx, scope, account, connection)
            cleanupAfter = now + SetupCodeBackoffSeconds(2)
        end if
        if not halted then
            creating = SetupReceipt(ctx, scope, "creating")
            if (creating <> invalid or SetupCodeNeedsReplacing(authorization, now)) and now >= createAfter then
                started = SetupBeginCreation(ctx, scope)
                if not started.ok then
                    m.top.state = { phase: "error" }
                    return
                end if
                creating = started.entry
                ctx.requestId = creating.requestId
                created = invalid
                if account then
                    created = HostedCodeCreate(ctx)
                else
                    created = QuickConnectCreate(ctx, connection)
                end if
                if created.ok then
                    committed = SetupCommitCreation(ctx, scope, creating, created.authorization)
                    if not committed.ok then
                        m.top.state = { phase: "error" }
                        return
                    end if
                    if committed.retired then
                        SetupJournalCleanup(ctx, scope, account, connection)
                        if not SessionAdmissionCurrent(ctx) then return
                    else
                        current = committed.entry
                        authorization = current.authorization
                        nextPoll = current.nextPollAt
                        failures = 0
                        m.top.state = SetupTaskState(authorization)
                    end if
                else
                    failures = failures + 1
                    delay = SetupCodeBackoffSeconds(failures)
                    if created.failure.retryAfterSeconds <> invalid and created.failure.retryAfterSeconds > delay then delay = created.failure.retryAfterSeconds
                    createAfter = NowSeconds() + delay
                    if authorization = invalid or SetupCodeExpired(authorization, NowSeconds()) then
                        phase = "creating"
                        if failures >= 2 then phase = "error"
                        m.top.state = { phase: phase }
                    end if
                end if
            else if authorization <> invalid and now >= nextPoll then
                polled = invalid
                if account then
                    polled = HostedCodePoll(ctx, authorization)
                else
                    polled = QuickConnectPoll(ctx, connection, authorization)
                end if
                if m.top.command = "stop" or polled.next = "retired" then
                    SetupJournalAbandon(ctx, scope, account, connection)
                    SetupRetireAccepted(ctx, account, polled)
                    return
                end if
                if polled.next = "approved" then
                    SetupJournalAccepted(ctx, scope, account, polled)
                    m.top.state = { phase: "approved" }
                    if account then
                        m.top.outcome = { ok: true, account: polled.grant.account }
                    else
                        m.top.outcome = polled.outcome
                    end if
                    return
                else if polled.next = "denied" or polled.next = "replace" then
                    SetupRetire(ctx, scope, current)
                    authorization = invalid
                    current = invalid
                    createAfter = 0
                    if polled.next = "denied" then
                        halted = true
                        m.top.state = { phase: "denied" }
                    end if
                else
                    authorization.interval = polled.interval
                    nextPoll = NowSeconds() + polled.waitSeconds
                    current.authorization = authorization
                    current.nextPollAt = nextPoll
                    StoreWriteJson(ctx.store, scope, "current", current)
                end if
            end if
        end if
        message = wait(1000, port)
        if message <> invalid then
            command = message.getData()
            if command = "stop" then
                SetupJournalAbandon(ctx, scope, account, connection)
                return
            else if command = "restart" then
                halted = false
                failures = 0
                createAfter = 0
                if authorization = invalid then m.top.state = { phase: "creating" }
            end if
        end if
    end while
end sub

function SetupTaskState(authorization as dynamic) as object
    if authorization = invalid then return { phase: "creating" }
    return { phase: "waiting", userCode: authorization.userCode, verificationUri: authorization.verificationUri, verificationUriComplete: authorization.verificationUriComplete }
end function

sub SetupRetireAccepted(ctx as object, account as boolean, polled as object)
    if account then
        if polled.grant = invalid then return
        current = HostedLoad(ctx)
        if current <> invalid and current.familyId = polled.grant.familyId then HostedClear(ctx)
    else
        if polled.outcome = invalid or not polled.outcome.ok then return
        issued = polled.outcome
        SessionRemoveFamily(ctx, issued.connection.pin.serverId, issued.session.sessionFamilyId)
    end if
end sub
