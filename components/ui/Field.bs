' apps/native/src/ui/Field.tsx (componentSpec.field, television column). A label, then the box:
' raised fill, a control border at rest, accent while focused, danger when invalid; the value (or
' the placeholder in the placeholder colour; a secret as bullets, at most Theme.apple.fieldSecureMax),
' then the error with its glyph, or the hint. On television a text field is a button: the remote
' focuses it like any other control and pressing it brings up the system keyboard, Roku's
' StandardKeyboardDialog (never a custom keyboard), tinted with the palette.
import "pkg:/source/Theme.bs"
import "pkg:/source/ThemeTables.bs"
import "pkg:/source/ui/Style.bs"
import "pkg:/source/ui/Nodes.bs"
import "pkg:/source/core/Messages.bs"
import "pkg:/source/ui/TVSignInMetrics.bs"

sub init()
    m.labelNode = MakeText(m.top, Theme.spec.field.label.role, "secondary")
    m.control = m.top.createChild("UiFocusable")
    m.control.focusScale = Theme.apple.fieldFocusScale
    m.fill = m.control.createChild("Poster")
    m.border = m.control.createChild("Poster")
    m.valueNode = MakeText(m.control, Theme.spec.field.text)
    m.valueMeasure = CreateObject("roSGNode", "Label")
    m.caret = m.control.createChild("Poster")
    m.caret.visible = false
    m.errorIcon = m.top.createChild("Poster")
    m.noteNode = MakeText(m.top, Theme.spec.field.help.role, "tertiary")
    m.noteNode.lines = 0
    m.control.observeField("isFocused", "onFieldLayout")
    m.control.observeField("pressed", "edit")
    m.dialog = invalid
    m.confirmedValue = invalid
    m.abandoned = false
    m.customEditing = false
end sub

sub onFieldLayout()
    width = m.top.fieldWidth
    if width <= 0 then return
    y = 0
    label = m.top.label
    m.labelNode.visible = label <> ""
    if label <> "" then
        m.labelNode.value = label
        y = m.labelNode.height + Theme.spec.field.label.gap
    end if
    height = Theme.spec.field.height
    radius = Theme.spec.field.radius
    focused = m.control.isFocused or (m.top.customEntry and m.customEditing)
    padding = Theme.spec.field.paddingX
    borderWidth = Theme.spec.field.borderWidth
    m.control.ring = not m.top.tvAuth
    m.control.focusScale = Theme.apple.fieldFocusScale
    if m.top.tvAuth then
        y = 0
        if label <> "" then y = TVSignInMetrics.fieldLabelOffset
        height = TVSignInMetrics.fieldHeight
        radius = TVSignInMetrics.fieldRadius
        padding = TVSignInMetrics.fieldPadding
        borderWidth = TVSignInMetrics.fieldBorder
        m.labelNode.role = "title"
        m.labelNode.tone = "tertiary"
        m.labelNode.sizeOverride = TVSignInMetrics.fieldLabelSize
        m.labelNode.lineHeightOverride = TVSignInMetrics.fieldLabelOffset
        m.valueNode.role = "bodyStrong"
        m.valueNode.sizeOverride = TVSignInMetrics.fieldSize
        m.valueNode.lineHeightOverride = TVSignInMetrics.fieldHeight
        m.control.focusScale = 1
    end if
    Place(m.control, 0, y)
    m.control.radius = radius
    m.control.controlWidth = width
    m.control.controlHeight = height
    m.control.disabled = not m.top.editable
    fill = ThemeColor(Theme.spec.field.fill.rest)
    border = ThemeColor(Theme.spec.field.border.rest)
    if focused then
        fill = ThemeColor(Theme.spec.field.fill.focus)
        border = ThemeColor(Theme.spec.field.border.focus)
    end if
    if m.top.tvAuth then
        fill = TVSignInMetrics.fieldFill
        border = Theme.colors.lineStrong
        if focused then border = Theme.colors.accentStrong
    end if
    if m.top.error <> "" then border = ThemeColor(Theme.spec.field.border.invalid_)
    StyleShape(m.fill, width, height, radius, fill)
    StyleRing(m.border, width, height, radius, borderWidth, border)

    ' A placeholder gives an example, never the field's identity again (PC-VISUAL §11.3).
    placeholder = m.top.placeholder
    if LCase(placeholder.trim()) = LCase(label.trim()) then placeholder = ""
    value = m.top.value
    shown = placeholder
    m.valueNode.tint = ThemeColor(Theme.spec.field.placeholder)
    if value <> "" then
        shown = value
        if m.top.secure then shown = String(Min(Len(value), Theme.apple.fieldSecureMax), "•")
        m.valueNode.tint = Theme.colors.text
    end if
    if m.top.tvAuth then
        font = CreateObject("roSGNode", "Font")
        font.uri = "pkg:/fonts/manrope-600.ttf"
        if value = "" then font.uri = "pkg:/fonts/manrope-500.ttf"
        font.size = TVSignInMetrics.fieldSize
        m.valueNode.font = font
        m.valueMeasure.font = font
        m.valueMeasure.text = shown
    end if
    m.valueNode.maxWidth = width - padding * 2
    m.valueNode.value = shown
    Place(m.valueNode, padding, (height - m.valueNode.height) / 2)
    showCaret = m.top.tvAuth and focused and m.dialog = invalid
    m.caret.visible = showCaret
    if showCaret then
        StyleShape(m.caret, TVSignInMetrics.caretWidth, TVSignInMetrics.caretHeight, TVSignInMetrics.caretRadius, Theme.colors.accentStrong)
        valueWidth = 0
        ' The displayed label has a fixed clipping width. The caret follows the actual
        ' live glyphs, not that box's right edge (including secure bullet metrics).
        if value <> "" then valueWidth = TextWidth(m.valueMeasure)
        Place(m.caret, Min(width - padding, padding + valueWidth + TVSignInMetrics.caretGap), (height - TVSignInMetrics.caretHeight) / 2)
    end if
    y = y + height

    note = m.top.hint
    isError = m.top.error <> ""
    if isError then note = m.top.error
    m.noteNode.visible = note <> ""
    m.errorIcon.visible = isError
    if note <> "" then
        y = y + Theme.spec.field.label.gap
        x = 0
        if isError then
            StyleIcon(m.errorIcon, Theme.spec.field.error.icon, Theme.metrics.iconSmall, Theme.colors.danger)
            Place(m.errorIcon, 0, y)
            x = Theme.metrics.iconSmall + Theme.space.xs
            m.noteNode.tone = "danger"
        else
            m.noteNode.tone = "tertiary"
        end if
        m.noteNode.maxWidth = width - x
        m.noteNode.value = note
        Place(m.noteNode, x, y)
        y = y + TextHeight(m.noteNode)
    end if
    m.top.fieldHeight = y
end sub

' Opens Roku's keyboard for this field.
sub edit()
    if not m.top.editable or m.dialog <> invalid then return
    if m.top.customEntry then
        m.customEditing = true
        onFieldLayout()
        m.top.editRequested = true
        return
    end if
    m.abandoned = false
    dialog = CreateObject("roSGNode", "StandardKeyboardDialog")
    title = m.top.label
    if title = "" then title = m.top.placeholder
    dialog.title = title
    dialog.text = m.top.value
    dialog.buttons = [T("action.done"), T("action.cancel")]
    domain = m.top.keyboard
    if m.top.secure then domain = "password"
    dialog.keyboardDomain = domain
    if dialog.textEditBox <> invalid then dialog.textEditBox.secureMode = m.top.secure
    palette = CreateObject("roSGNode", "RSGPalette")
    palette.colors = {
        DialogBackgroundColor: Theme.colors.overlaySurface
        DialogTextColor: Theme.colors.text
        DialogFocusColor: Theme.colors.focus
        DialogFocusItemColor: Theme.colors.ink
        DialogSecondaryTextColor: Theme.colors.textSecondary
        DialogSecondaryItemColor: Theme.colors.textTertiary
        DialogInputFieldColor: Theme.colors.raised
        DialogKeyboardColor: Theme.colors.raised
        DialogFootprintColor: Theme.colors.lineStrong
    }
    dialog.palette = palette
    dialog.observeField("buttonSelected", "onFieldDialogButton")
    dialog.observeField("wasClosed", "onFieldDialogClosed")
    m.dialog = dialog
    m.confirmedValue = invalid
    onFieldLayout()
    m.top.getScene().dialog = dialog
end sub

sub onFieldDialogButton()
    if m.dialog = invalid then return
    confirmed = m.dialog.buttonSelected = 0
    if confirmed then m.confirmedValue = m.dialog.text
    m.dialog.text = ""
    m.dialog.close = true
end sub

sub onFieldDialogClosed()
    m.dialog = invalid
    if m.abandoned then return
    m.control.setFocus(true)
    if m.confirmedValue <> invalid then
        value = m.confirmedValue
        m.confirmedValue = invalid
        m.top.value = value
        m.top.submitted = true
    end if
    onFieldLayout()
end sub

sub cancelEdit()
    m.abandoned = true
    m.customEditing = false
    m.confirmedValue = invalid
    if m.dialog <> invalid then
        m.dialog.text = ""
        m.dialog.close = true
    end if
    m.caret.visible = false
end sub
