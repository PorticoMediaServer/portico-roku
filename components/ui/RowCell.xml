<?xml version="1.0" encoding="utf-8"?>
<!-- apps/native/src/ui/ListRow.tsx as an item of a MarkupGrid: a media row (a song in a library's Songs tab). -->
<component name="UiRowCell" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onCellContent" />
        <field id="width" type="float" value="0" onChange="onCellContent" />
        <field id="height" type="float" value="0" onChange="onCellContent" />
        <field id="focusPercent" type="float" value="0" onChange="onCellFocus" />
        <field id="itemHasFocus" type="boolean" value="false" onChange="onCellFocus" />
        <field id="gridHasFocus" type="boolean" value="false" onChange="onCellFocus" />
    </interface>
</component>
