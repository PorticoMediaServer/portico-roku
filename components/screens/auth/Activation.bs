' apps/native/src/screens/auth/Activation.tsx. Nothing to type: scan or visit, approve on a phone,
' done. The code is the Portico Account's (POST /v1/device-authorizations on the account service;
' components/tasks/SetupCodeTask). Under the code row, the buttons, then the terms note.
'
' The front door contacts Portico Services only after its main Portico Account action. The Local
' action opens the address probe. An existing account may open its directory after that choice;
' a new account signs in with the genuine same-account consent code.
import "pkg:/source/Theme.bs"
import "pkg:/source/ThemeTables.bs"
import "pkg:/source/ui/Style.bs"
import "pkg:/source/ui/Nodes.bs"
import "pkg:/source/ui/Layout.bs"
import "pkg:/source/core/Messages.bs"

sub init()
    m.session = m.global.session
    m.frame = m.top.createChild("AuthFrame")
    m.frame.wide = true
    m.frame.centered = true
    m.frame.observeField("errorDismissed", "onActivationDismiss")
    m.content = CreateObject("roSGNode", "Group")
    m.panel = m.content.createChild("AuthCodePanel")
    m.panel.qrSize = Theme.apple.activationQr
    m.panel.observeField("actionPressed", "onActivationRestart")
    m.buttons = m.content.createChild("Group")
    m.buttons.addFields({ boxWidth: 0, boxHeight: 0 })
    m.account = m.buttons.createChild("UiButton")
    m.account.variant = "primary"
    m.account.size = "lg"
    m.account.label = T("accounts.signIn.portico")
    m.account.observeField("pressed", "onActivationAccount")
    m.direct = m.buttons.createChild("UiButton")
    m.direct.variant = "secondary"
    m.direct.size = "lg"
    m.direct.label = T("accounts.signIn.local")
    m.direct.observeField("pressed", "onActivationDirect")
    m.saved = m.buttons.createChild("UiButton")
    m.saved.variant = "ghost"
    m.saved.size = "lg"
    m.saved.label = T("auth.backToSavedServer")
    m.saved.observeField("pressed", "onActivationSaved")
    m.terms = MakeText(m.content, "caption", "tertiary")
    m.terms.lines = 0
    m.terms.align = "center"
    m.state = { phase: "idle" }
    m.started = false
    m.failure = ""
    m.task = invalid
    m.session.observeField("error", "onActivationLayout")
    m.session.observeField("note", "onActivationLayout")
    m.session.observeField("hasRecovery", "onActivationLayout")
end sub

sub enter()
    onActivationLayout()
    m.frame.callFunc("focusContent", m.account)
end sub

sub ActivationStart()
    leave()
    m.started = true
    m.task = CreateObject("roSGNode", "SetupCodeTask")
    m.task.mode = "account"
    m.task.observeField("state", "onActivationState")
    m.task.observeField("outcome", "onActivationOutcome")
    m.task.control = "RUN"
end sub

' Leaving the screen cancels the code.
sub leave()
    if m.task <> invalid then
        m.task.unobserveField("state")
        m.task.unobserveField("outcome")
        m.task.command = "stop"
        m.task = invalid
    end if
end sub

function back() as boolean
    return false
end function

sub onActivationState()
    if m.task = invalid then return
    m.state = m.task.state
    onActivationLayout()
end sub

sub onActivationOutcome()
    if m.task = invalid then return
    outcome = m.task.outcome
    m.task = invalid
    if outcome.ok then
        m.session.callFunc("accountApproved", outcome.account)
        m.top.approved = true
    else
        ' That approval is spent: a fresh code replaces it and the error says what happened.
        m.failure = T("apple.activation.failed")
        ActivationStart()
        onActivationLayout()
    end if
end sub

sub onActivationRestart()
    if m.task <> invalid then m.task.command = "restart"
end sub

sub onActivationLayout()
    width = m.frame.contentWidth
    state = m.state
    host = T("apple.activation.defaultHost")
    link = ""
    code = ""
    if state.userCode <> invalid then code = state.userCode
    if state.verificationUri <> invalid then host = CreateObject("roRegex", "^https?://", "i").replace(state.verificationUri, "")
    if state.verificationUriComplete <> invalid then
        link = state.verificationUriComplete
    else if state.verificationUri <> invalid then
        link = state.verificationUri
    end if
    m.frame.title = T("web.signin.welcomeHome")
    if m.started then m.frame.title = T("accounts.signIn.portico")
    m.frame.lead = ""
    if m.started then m.frame.lead = T("accounts.consent.portico")
    m.frame.note = m.session.note
    problem = m.failure
    if problem = "" and state.phase = "error" then problem = T("apple.activation.failed")
    if problem = "" and not m.session.hasRecovery then problem = m.session.error
    m.frame.error = problem

    m.panel.panelWidth = width
    m.panel.host = host
    m.panel.userCode = code
    m.panel.link = link
    if state.phase = "denied" then
        m.panel.message = T("activation.declined")
        m.panel.action = T("activation.getNewCode")
    else if state.phase = "error" then
        m.panel.message = T("activation.codeFailed")
        m.panel.action = T("action.tryAgain")
    else
        m.panel.message = T("activation.preparingCode")
        m.panel.action = ""
    end if
    m.panel.phase = state.phase

    m.account.visible = not m.started
    m.account.focusable = not m.started
    m.panel.visible = m.started
    m.saved.visible = m.session.hasRecovery
    m.saved.focusable = m.session.hasRecovery
    rowHeight = StackRow([m.account, m.direct, m.saved], 0, Theme.space.md, width)
    m.buttons.boxWidth = width
    m.buttons.boxHeight = rowHeight
    m.terms.maxWidth = width
    m.terms.value = T("activation.termsNote")
    nodes = [m.buttons]
    if m.started then nodes = [m.panel, m.buttons, m.terms]
    height = StackColumn(nodes, 0, Theme.space.lg, width)
    m.frame.callFunc("setContent", m.content, height)
end sub

sub onActivationDismiss()
    m.failure = ""
    m.session.callFunc("clearError")
    onActivationLayout()
end sub

sub onActivationAccount()
    if m.started then return
    if m.session.hasAccount then
        m.session.callFunc("requestAccount")
        return
    end if
    ActivationStart()
    onActivationLayout()
    m.frame.callFunc("focusContent", m.direct)
end sub

sub onActivationDirect()
    m.top.directPressed = true
end sub

sub onActivationSaved()
    m.top.savedServerPressed = true
end sub
