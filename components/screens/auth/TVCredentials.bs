import "pkg:/source/ui/TVSignInMetrics.bs"
import "pkg:/source/Theme.bs"
import "pkg:/source/ThemeTables.bs"
import "pkg:/source/ui/IdentityFrameMetrics.bs"
import "pkg:/source/core/TVSignIn.bs"
import "pkg:/source/core/Errors.bs"
import "pkg:/source/core/Messages.bs"
import "pkg:/source/ui/Nodes.bs"
import "pkg:/source/ui/Style.bs"
import "pkg:/source/ui/Layout.bs"
import "pkg:/source/ui/Focus.bs"

sub init()
    m.session = m.global.session
    m.mode = "credentials"
    m.connection = invalid
    m.failure = ""
    backdrop = m.top.createChild("Poster")
    backdrop.uri = "pkg:/images/gradients/auth-left.png"
    backdrop.width = Theme.screen.width
    backdrop.height = Theme.screen.height
    wordmark = m.top.createChild("Poster")
    wordmark.uri = "pkg:/images/brand/wordmark.png"
    wordmark.height = TVSignInMetrics.wordmarkHeight
    wordmark.width = TVSignInMetrics.wordmarkHeight * Theme.apple.wordmarkAspect
    Place(wordmark, TVSignInMetrics.left, TVSignInMetrics.wordmarkTop)
    m.column = m.top.createChild("Group")
    m.why = MakeText(m.column, "body", "secondary")
    m.why.sizeOverride = TVSignInMetrics.whySize
    m.why.lineHeightOverride = TVSignInMetrics.whyHeight
    m.heading = m.column.createChild("IdentityHeading")
    m.heading.textSize = TVSignInMetrics.titleSize
    m.heading.lineHeight = TVSignInMetrics.titleSize
    m.heading.tracking = TVSignInMetrics.titleSize * TVSignInMetrics.titleTracking
    m.heading.maxWidth = TVSignInMetrics.columnWidth
    m.lead = MakeText(m.column, "body", "secondary")
    m.lead.sizeOverride = TVSignInMetrics.leadSize
    m.lead.lineHeightOverride = TVSignInMetrics.leadHeight
    m.lead.lines = 0
    m.lead.maxWidth = TVSignInMetrics.leadWidth
    m.notice = m.column.createChild("UiNotice")
    m.notice.tone = "error"
    m.notice.action = ""
    m.notice.noticeWidth = TVSignInMetrics.fieldWidth
    m.user = m.column.createChild("UiField")
    m.password = m.column.createChild("UiField")
    for each field in [m.user, m.password]
        field.tvAuth = true
        field.fieldWidth = TVSignInMetrics.fieldWidth
    end for
    m.password.secure = true
    m.password.label = T("auth.password")
    m.user.observeField("submitted", "onCredentialUser")
    m.password.observeField("submitted", "onCredentialPassword")
    m.user.observeField("value", "onCredentialFields")
    m.password.observeField("value", "onCredentialFields")
    m.actions = m.column.createChild("Group")
    m.primary = m.actions.createChild("UiButton")
    m.primary.variant = "primary"
    m.primary.size = "lg"
    m.primary.authAppearance = true
    m.primary.observeField("pressed", "onCredentialSubmit")
    m.back = m.actions.createChild("UiButton")
    m.back.variant = "secondary"
    m.back.size = "lg"
    m.back.authAppearance = true
    m.back.label = T("action.back")
    m.back.observeField("pressed", "onCredentialBack")
    m.terms = MakeText(m.top, "body", "tertiary")
    m.terms.sizeOverride = TVSignInMetrics.termsSize
    m.terms.lineHeightOverride = TVSignInMetrics.termsLineHeight
    m.terms.lines = 0
    m.terms.maxWidth = TVSignInMetrics.columnWidth
    m.terms.value = T("roku.tvSignIn.agreement")
    m.legal = m.top.createChild("Group")
    m.termsAddress = MakeText(m.legal, "body", "tertiary")
    m.privacyAddress = MakeText(m.legal, "body", "tertiary")
    for each text in [m.termsAddress, m.privacyAddress]
        text.sizeOverride = TVSignInMetrics.termsSize
        text.lineHeightOverride = TVSignInMetrics.termsLineHeight
    end for
    m.termsAddress.value = T("accounts.legal.termsAddress")
    m.privacyAddress.value = T("accounts.legal.privacyAddress")
    Place(m.privacyAddress, TextWidth(m.termsAddress) + TVSignInMetrics.legalGap, 0)
    m.pad = m.top.createChild("AuthFactorPad")
    m.pad.observeField("submitted", "onCredentialFactor")
    m.pad.observeField("recoveryPressed", "onCredentialRecovery")
    m.recovery = m.column.createChild("UiField")
    m.recovery.tvAuth = true
    m.recovery.customEntry = true
    m.recovery.fieldWidth = TVSignInMetrics.fieldWidth
    m.recovery.label = ""
    m.recovery.observeField("editRequested", "onCredentialRecoveryEdit")
    m.keyboard = m.top.createChild("AuthRecoveryKeyboard")
    m.keyboard.observeField("value", "onCredentialRecoveryValue")
    m.keyboard.visible = false
    m.session.observeField("accountCredentialState", "onCredentialState")
    m.session.observeField("directStep", "onCredentialState")
    m.session.observeField("directFailure", "onCredentialState")
    m.session.observeField("requiresTwoStepSetup", "onCredentialState")
    m.session.observeField("error", "onCredentialState")
    m.session.observeField("busy", "onCredentialState")
end sub

sub enter()
    m.connection = m.session.connection
    if m.top.kind = "local" then
        if not TVSignInLocalCurrent(m.connection, m.session.connection) then
            m.top.backPressed = true
            return
        end if
        m.user.value = m.session.username
    else
        m.session.callFunc("beginAccountCredentials")
    end if
    onCredentialState()
    CredentialEntryFocus()
end sub

sub leave()
    for each field in [m.user, m.password, m.recovery]
        field.callFunc("cancelEdit")
        field.value = ""
    end for
    m.pad.callFunc("leave")
    if m.top.kind = "portico" then
        m.session.callFunc("cancelAccountCredentials")
    end if
end sub

sub onCredentialState()
    if m.heading = invalid then return
    previous = m.mode
    busy = m.session.busy
    if m.top.kind = "portico" then
        state = m.session.accountCredentialState
        busy = false
        if state <> invalid then
            busy = state.phase = "working" or state.phase = "starting" or state.phase = "awaiting-accept"
            if state.phase = "challenge" then m.mode = "factor"
            if state.phase = "error" then
                m.failure = TVSignInFailure(state.failure, "portico")
                m.pad.value = ""
                if m.mode = "credentials" then m.password.value = ""
            end if
        end if
    else
        m.failure = m.session.error
        if m.session.directFailure <> invalid then m.failure = TVSignInFailure(m.session.directFailure, "local", m.connection.serverName)
        if m.session.directStep = "challenge" then m.mode = "factor"
        if m.failure <> "" and m.mode = "factor" then m.pad.value = ""
    end if
    blocked = m.top.kind = "local" and m.session.requiresTwoStepSetup = true
    m.user.editable = not busy and not blocked
    m.password.editable = not busy and not blocked
    m.recovery.editable = not busy and not blocked
    m.pad.busy = busy
    m.primary.loading = busy
    m.primary.disabled = busy
    CredentialLayout()
    if previous <> m.mode then CredentialEntryFocus()
end sub

sub CredentialLayout()
    password = m.mode = "credentials"
    recovery = m.mode = "recovery"
    local = m.top.kind = "local"
    m.why.visible = password and local
    m.why.value = T("accounts.signIn.to")
    title = T("web.signin.welcomeHome")
    lede = T("roku.tvSignIn.hostedLead")
    if local and password then
        title = m.connection.serverName
        lede = T("apple.direct.passwordLead")
    end if
    if not password then
        title = T("web.direct.codeTitle")
        lede = T("roku.tvSignIn.codeLead")
    end if
    m.heading.value = title
    m.lead.value = lede
    m.user.label = T("roku.tvSignIn.identity")
    m.user.placeholder = T("apple.direct.usernameExample")
    m.primary.label = T("action.continue")
    if local then
        m.user.label = T("auth.username")
        m.user.placeholder = ""
        if password then m.primary.label = T("auth.signIn")
    end if
    m.user.visible = password
    m.password.visible = password
    m.recovery.visible = recovery
    m.primary.visible = password or recovery
    m.pad.visible = not password and not recovery
    m.terms.visible = not local and password
    m.legal.visible = m.terms.visible
    m.notice.visible = m.failure <> ""
    m.notice.message = m.failure
    y = 0
    if m.why.visible then
        Place(m.why, 0, y)
        y = y + TVSignInMetrics.whyHeight + TVSignInMetrics.whyGap
    end if
    Place(m.heading, 0, y)
    y = y + m.heading.contentHeight + TVSignInMetrics.titleGap
    Place(m.lead, 0, y)
    y = y + TextHeight(m.lead) + TVSignInMetrics.leadGap
    if m.notice.visible then
        Place(m.notice, 0, y)
        y = y + m.notice.noticeHeight + TVSignInMetrics.fieldGap
    end if
    factorTop = y
    if password then
        Place(m.user, 0, y)
        y = y + m.user.fieldHeight + TVSignInMetrics.fieldGap
        Place(m.password, 0, y)
        y = y + m.password.fieldHeight + TVSignInMetrics.actionTop
    else if recovery then
        Place(m.recovery, 0, y)
        y = y + m.recovery.fieldHeight + TVSignInMetrics.actionTop
    else
        y = y + TVSignInMetrics.boxHeight + TVSignInMetrics.actionTop
    end if
    Place(m.actions, 0, y)
    nodes = [m.primary, m.back]
    if not password and not recovery then nodes = [m.back]
    height = StackRow(nodes, 0, TVSignInMetrics.actionGap, TVSignInMetrics.columnWidth, 0, "start")
    y = y + height
    top = (Theme.screen.height - y) / 2
    if recovery then top = TVSignInMetrics.wordmarkTop + TVSignInMetrics.wordmarkHeight + TVSignInMetrics.leadGap
    Place(m.column, TVSignInMetrics.left, top)
    m.pad.boxTop = top + factorTop
    Place(m.terms, TVSignInMetrics.left, Theme.screen.height - TVSignInMetrics.termsBottom - TextHeight(m.terms) - TVSignInMetrics.termsLineHeight)
    Place(m.legal, TVSignInMetrics.left, Theme.screen.height - TVSignInMetrics.termsBottom - TVSignInMetrics.termsLineHeight)
    if recovery then Place(m.keyboard, TVSignInMetrics.left, top + y + TVSignInMetrics.fieldGap)
    onCredentialFields()
end sub

sub onCredentialFields()
    if m.primary = invalid then return
    empty = false
    if m.mode = "credentials" then empty = m.user.value = "" or m.password.value = ""
    if m.mode = "recovery" then empty = m.recovery.value = ""
    blocked = m.top.kind = "local" and m.session.requiresTwoStepSetup = true
    m.primary.disabled = m.primary.loading or empty or blocked
end sub

sub CredentialEntryFocus()
    if m.mode = "factor" then
        m.pad.callFunc("focusEntry")
    else if m.mode = "recovery" then
        FocusOn(m.recovery)
    else if m.user.value = "" then
        FocusOn(m.user)
    else
        FocusOn(m.password)
    end if
end sub

sub onCredentialUser()
    m.password.callFunc("edit")
end sub

sub onCredentialPassword()
    FocusOn(m.primary)
end sub

sub onCredentialSubmit()
    if m.primary.loading then return
    m.failure = ""
    if m.mode = "recovery" then
        CredentialFactor(m.recovery.value)
    else if m.user.value <> "" and m.password.value <> "" then
        if m.top.kind = "portico" then
            m.session.callFunc("submitAccountCredentials", { kind: "login", username: m.user.value, password: m.password.value })
        else if TVSignInLocalCurrent(m.connection, m.session.connection) then
            m.session.callFunc("signIn", { username: m.user.value, password: m.password.value, expectedConnection: m.connection })
        end if
        m.password.value = ""
    end if
end sub

sub onCredentialFactor()
    CredentialFactor(m.pad.value)
end sub

sub CredentialFactor(value as string)
    if value = "" then return
    m.failure = ""
    if m.top.kind = "portico" then
        m.session.callFunc("submitAccountCredentials", { kind: "mfa", factor: value })
    else if TVSignInLocalCurrent(m.connection, m.session.connection) then
        m.session.callFunc("completeChallenge", value)
    end if
end sub

sub onCredentialRecovery()
    m.mode = "recovery"
    m.pad.value = ""
    CredentialLayout()
    FocusOn(m.recovery)
end sub

sub onCredentialRecoveryEdit()
    m.keyboard.value = m.recovery.value
    m.keyboard.visible = true
    m.keyboard.callFunc("focusEntry")
end sub

sub onCredentialRecoveryValue()
    m.recovery.value = m.keyboard.value
    onCredentialFields()
end sub

sub onCredentialBack()
    back()
end sub

function back() as boolean
    if m.top.kind = "local" then m.session.callFunc("cancelStep")
    leave()
    m.top.backPressed = true
    return true
end function

function onKeyEvent(key as string, press as boolean) as boolean
    if key = "back" then
        if press then return back()
        return true
    end if
    direction = FocusDirection(key)
    if direction <> "" then
        if press then return FocusMove(m.top, direction)
        return true
    end if
    return false
end function
