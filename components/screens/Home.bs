' apps/native/src/screens/Home.tsx (with app/home.ts). The hero is the server's choice (what the
' viewer was last in the middle of); under it the server's authored rows, in the server's order,
' each a shelf. The channel ranks, hides and re-pages nothing: a row's next page is asked for by
' the row's own cursor as focus nears its end, and a row keeps at most HomeRowMaxEntries cards.
'
' Hero: at least Theme.metrics.heroHeight tall, its words in a column at most
' Theme.apple.homeHeroWidthFraction of the screen wide, bottom-aligned: the row's name as an
' eyebrow, the title in the display role (two lines), the line under it, the facts, the synopsis
' (three lines), a progress bar when started, then Play (primary, large, with what is left) and
' Details. Behind it, wide artwork that stays put while the rows move.
'
' With no hero the screen opens on the server's name and "Home", and the first row's first card
' takes the opening focus. A transient failure is tried again on its own (source/core/Retry.bs).
import "pkg:/source/Theme.bs"
import "pkg:/source/ThemeTables.bs"
import "pkg:/source/ui/Style.bs"
import "pkg:/source/ui/Nodes.bs"
import "pkg:/source/ui/Focus.bs"
import "pkg:/source/ui/Layout.bs"
import "pkg:/source/core/Messages.bs"
import "pkg:/source/core/Errors.bs"
import "pkg:/source/core/Home.bs"
import "pkg:/source/core/Readers.bs"
import "pkg:/source/core/Open.bs"
import "pkg:/source/core/Retry.bs"
import "pkg:/source/core/Time.bs"
import "pkg:/components/app/Nav.bs"

sub init()
    m.width = Theme.screen.width - Theme.metrics.railWidth
    m.backdrop = m.top.createChild("UiBackdrop")
    m.backdrop.backdropWidth = m.width
    m.backdrop.backdropHeight = Theme.metrics.heroHeight + Theme.apple.homeHeroArtExtra
    m.backdrop.imageOpacity = Theme.apple.homeHeroArtOpacity
    m.backdrop.visible = false
    m.page = m.top.createChild("UiPage")
    m.page.pageWidth = m.width
    m.page.observeField("scrollY", "onHomeScroll")
    m.body = m.page.body
    m.task = invalid
    m.homeGeneration = 0
    m.homeActive = false
    m.homeOpening = -1
    m.document = invalid
    m.hydrationTasks = {}
    m.hydrationQueue = []
    m.hydrationErrors = {}
    m.hydrationErrorNodes = {}
    m.paging = {}
    m.rows = []
    m.shelves = []
    m.hero = invalid
    m.play = invalid
    m.details = invalid
    m.loadedAt = 0
    m.attempt = 0
    m.claimed = false
    m.changes = 0
    m.retry = m.top.createChild("Timer")
    m.retry.observeField("fire", "onHomeRetry")
    m.liveExpiry = m.top.createChild("Timer")
    m.liveExpiry.observeField("fire", "onHomeLiveExpiry")
end sub

sub enter()
    m.global.session.observeField("viewer", "onHomeViewerChanged")
    HomeOpen()
end sub

' Returning to Home: Continue Watching and what was just added are expected to be current.
sub resume()
    if not HomeCurrent() then
        HomeOpen()
        return
    end if
    changed = PersonalChanges() <> m.changes
    m.changes = PersonalChanges()
    if m.task = invalid and (changed or NowSeconds() - m.loadedAt > HomeStaleSeconds()) then HomeLoad(0)
end sub

sub leave()
    retireHome()
    m.global.session.unobserveField("viewer")
end sub

sub focusEntry()
    if not HomeCurrent() then return
    if m.play <> invalid then
        FocusOn(m.play)
        m.page.callFunc("follow")
    else if m.details <> invalid then
        FocusOn(m.details)
        m.page.callFunc("follow")
    else if not m.page.callFunc("focusEntry") then
        m.top.setFocus(true)
    end if
end sub

sub HomeLoad(attempt as integer)
    if not HomeCurrent() then return
    HomeRetireHydrations()
    if m.task <> invalid then m.task.control = "STOP"
    m.retry.control = "stop"
    m.attempt = attempt
    m.task = ApiStart({ path: "/v1/home", reader: "home", expectedViewer: m.homeBinding, context: { origin: m.homeBinding.origin } }, "onHomeLoaded")
    m.task.addFields({ homeGeneration: m.homeGeneration, homeOpening: m.homeOpening })
end sub

sub onHomeRetry()
    HomeLoad(m.attempt + 1)
end sub

sub onHomeLoaded(event as object)
    task = event.getRoSGNode()
    if not HomeCurrent() or task.homeOpening <> m.homeOpening or task.homeGeneration <> m.homeGeneration then return
    if m.task = invalid or not task.isSameNode(m.task) then return
    m.task = invalid
    result = event.getData()
    if not result.ok or result.value.ok <> true then
        failure = result.error
        if failure = invalid then failure = { code: "invalid_response", status: 0 }
        facts = PresentErrorFacts(failure, "home")
        transient = RetryIsTransient(facts.category)
        if transient then
            plan = RetryPlan(m.attempt)
            m.retry.duration = plan.seconds
            m.retry.control = "start"
            ' During the quick retries keep the skeleton (or the rows) exactly as they are.
            if plan.quick then return
        end if
        if m.rows.count() = 0 then HomeFailure(failure, transient)
        return
    end if
    m.loadedAt = NowSeconds()
    m.document = result.value.document
    if not HomeViewerCurrent(m.homeBinding, ViewerRequestBinding(m.global.session.viewer)) or m.document.serverId <> m.homeBinding.serverId then return
    HomeBuild(result.value, task.content)
    for each row in m.document.rows
        if row.deferred then m.hydrationQueue.push(row)
    end for
    HomeHydrate()
    if m.hydrationErrors.count() > 0 then HomeRenderHydration()
end sub

sub onHomeViewerChanged()
    if not m.top.homePresented then return
    if HomeCurrent() then return
    retireHome()
    HomeOpen()
end sub

sub HomeRetireHydrations()
    m.homeGeneration = m.homeGeneration + 1
    m.liveExpiry.control = "stop"
    for each key in m.paging.keys()
        m.paging[key].control = "STOP"
    end for
    for each key in m.hydrationTasks.keys()
        m.hydrationTasks[key].control = "STOP"
    end for
    m.hydrationTasks = {}
    m.hydrationQueue = []
    m.hydrationErrors = {}
    m.paging = {}
end sub

function HomePending() as boolean
    if m.document = invalid then return false
    if m.document.spotlight.count() > 0 and m.hero = invalid then return true
    for each row in m.document.rows
        if row.deferred then return true
    end for
    return false
end function

sub HomeHydrate()
    if not HomeCurrent() or m.document = invalid then return
    while HomeHydrationRoom(m.hydrationTasks.count()) > 0 and m.hydrationQueue.count() > 0
        row = m.hydrationQueue.shift()
        if row.endpoint <> "/v1/home/rows/" + row.id or row.viewerFence <> m.document.viewerFence then
            m.hydrationErrors[row.id] = row
        else
            path = HomeRowPagePath(row.id, "", row.limit)
            task = ApiStart({ path: path, reader: "homeRow", expectedViewer: m.homeBinding, context: { origin: m.homeBinding.origin, rowId: row.id, viewerFence: m.document.viewerFence, revision: row.revision } }, "onHomeHydrated")
            task.addFields({ homeGeneration: m.homeGeneration, homeOpening: m.homeOpening, descriptor: row })
            m.hydrationTasks[row.id] = task
        end if
    end while
end sub

sub onHomeHydrated(event as object)
    task = event.getRoSGNode()
    descriptor = task.descriptor
    if not HomeCurrent() or task.homeOpening <> m.homeOpening or task.homeGeneration <> m.homeGeneration or m.document = invalid then return
    if not HomeViewerCurrent(m.homeBinding, ViewerRequestBinding(m.global.session.viewer)) then return
    held = m.hydrationTasks[descriptor.id]
    if held = invalid or not held.isSameNode(task) then return
    m.hydrationTasks.delete(descriptor.id)
    result = event.getData()
    if not result.ok or result.value.ok <> true or result.value.row.viewerFence <> m.document.viewerFence then
        m.hydrationErrors[descriptor.id] = descriptor
    else
        row = result.value.row
        rows = HomeHydratedRows(m.document.rows, descriptor, row, m.document.viewerFence)
        if rows = invalid then
            m.hydrationErrors[descriptor.id] = descriptor
        else
            m.document.rows = rows
            m.hydrationErrors.delete(descriptor.id)
        end if
    end if
    HomeRenderHydration()
    HomeHydrate()
end sub

sub HomeRenderHydration()
    if not HomeCurrent() or m.document = invalid then return
    rendered = ReadHomeDocument(m.document, { origin: m.homeBinding.origin })
    HomeBuild(rendered.value, rendered.content)
end sub

sub onHomeHydrationRetry(event as object)
    node = event.getRoSGNode()
    id = node.rowId
    held = m.hydrationErrorNodes[id]
    if not HomeCurrent() or held = invalid or not node.isSameNode(held) then return
    if not HomeViewerCurrent(m.homeBinding, ViewerRequestBinding(m.global.session.viewer)) then return
    row = m.hydrationErrors[id]
    if row = invalid then return
    m.hydrationErrors.delete(id)
    m.hydrationQueue.push(row)
    HomeRenderHydration()
    HomeHydrate()
end sub

sub HomeClear()
    m.body.removeChildrenIndex(m.body.getChildCount(), 0)
    m.shelves = []
    m.hydrationErrorNodes = {}
    m.play = invalid
    m.details = invalid
end sub

function HomeTop() as float
    return Theme.apple.pageTopInset - Theme.space.lg
end function

' The first load reserves the hero's place, so the rows do not jump when it arrives.
sub HomeSkeleton()
    HomeClear()
    page = Theme.space.page
    y = HomeTop() + Theme.metrics.heroHeight - Theme.space.xl - Theme.metrics.control - Theme.space.lg - Theme.apple.homeSkeletonLineHeight - Theme.space.sm - Theme.apple.homeSkeletonTitleHeight
    HomeBlock(page, y, Theme.apple.homeSkeletonTitleWidth, Theme.apple.homeSkeletonTitleHeight, -1)
    y = y + Theme.apple.homeSkeletonTitleHeight + Theme.space.sm
    HomeBlock(page, y, Theme.apple.homeSkeletonLineWidth, Theme.apple.homeSkeletonLineHeight, -1)
    y = y + Theme.apple.homeSkeletonLineHeight + Theme.space.sm + Theme.space.lg
    HomeBlock(page, y, Theme.apple.homeSkeletonButtonWidth, Theme.metrics.control, Theme.metrics.radius.control)
    HomeBlock(page + Theme.apple.homeSkeletonButtonWidth + Theme.space.sm, y, Theme.apple.homeSkeletonButtonWidth, Theme.metrics.control, Theme.metrics.radius.control)
    y = HomeTop() + Theme.metrics.heroHeight
    for row = 0 to 1
        HomeBlock(page, y, Theme.apple.homeSkeletonHeadingWidth, Theme.metrics.icon, Theme.metrics.radius.small)
        y = y + Theme.metrics.icon + Theme.space.md
        cardHeight = Int(Theme.metrics.posterWidth / ArtworkRatio("poster"))
        for index = 0 to Theme.apple.homeSkeletonCards - 1
            HomeBlock(page + index * (Theme.metrics.posterWidth + Theme.space.gutter), y, Theme.metrics.posterWidth, cardHeight, -1)
        end for
        y = y + cardHeight + Theme.space.xl
    end for
    m.page.contentHeight = y
end sub

sub HomeBlock(x as dynamic, y as dynamic, width as dynamic, height as dynamic, radius as dynamic)
    block = m.body.createChild("UiSkeleton")
    block.radius = radius
    block.blockHeight = height
    block.blockWidth = width
    Place(block, x, y)
end sub

sub HomeFailure(failure as object, retrying as boolean)
    HomeClear()
    words = PresentError(failure, "home", { retrying: retrying })
    state = m.body.createChild("UiStateView")
    state.icon = "warning"
    state.title = words.title
    state.message = words.body
    state.action = words.actionLabel
    state.stateHeight = Theme.screen.height
    state.stateWidth = m.width
    state.observeField("actionPressed", "onHomeRefresh")
    m.page.contentHeight = Theme.screen.height
    m.page.callFunc("refresh")
    NavClaimFocus()
end sub

sub onHomeRefresh()
    if not HomeCurrent() then return
    HomeSkeleton()
    HomeLoad(0)
end sub

sub HomeBuild(value as object, content as object)
    if not HomeCurrent() then return
    had = FocusedShelfState()
    HomeClear()
    m.rows = value.rows
    m.hero = value.hero
    y = HomeTop()
    if m.hero <> invalid then
        y = y + HomeHeroBuild(m.hero, y)
    else
        ' No hero: the server's name and "Home".
        m.backdrop.visible = false
        viewer = m.global.session.viewer
        name = T("web.home.serverFallback")
        if viewer <> invalid and viewer.serverName <> "" then name = viewer.serverName
        eyebrow = MakeText(m.body, "label", "tertiary", name)
        title = MakeText(m.body, "title", "primary", T("web.shell.home"))
        Place(eyebrow, Theme.space.page, y + Theme.space.xl)
        Place(title, Theme.space.page, y + Theme.space.xl + eyebrow.height)
        y = y + Theme.space.xl + eyebrow.height + title.height + Theme.space.lg
    end if
    for index = 0 to m.rows.count() - 1
        row = m.rows[index]
        if row.pending then
            if m.hydrationErrors.doesExist(row.id) then
                words = PresentError({ code: "request_failed", status: 0 }, "home")
                state = m.body.createChild("UiStateView")
                state.addFields({ rowId: row.id })
                m.hydrationErrorNodes[row.id] = state
                state.icon = "warning"
                state.title = row.title
                state.message = words.body
                state.action = T("action.tryAgain")
                state.stateWidth = m.width
                state.observeField("actionPressed", "onHomeHydrationRetry")
                Place(state, 0, y)
                y = y + state.boundingRect().height
            else
                HomeBlock(Theme.space.page, y, Theme.apple.homeSkeletonHeadingWidth, Theme.metrics.icon, Theme.metrics.radius.small)
                y = y + Theme.metrics.icon + Theme.space.md
                cardHeight = Int(Theme.metrics.posterWidth / ArtworkRatio(row.shape))
                for card = 0 to Theme.apple.homeSkeletonCards - 1
                    HomeBlock(Theme.space.page + card * (Theme.metrics.posterWidth + Theme.space.gutter), y, Theme.metrics.posterWidth, cardHeight, -1)
                end for
                y = y + cardHeight + Theme.space.xl
            end if
        else
            shelf = m.body.createChild("UiShelf")
            shelf.addFields({ rowIndex: index })
            shelf.shelfWidth = m.width
            shelf.shape = row.shape
            shelf.titleLines = row.titleLines
            shelf.title = row.title
            shelf.seeAllLabel = row.seeAllLabel
            shelf.seeAll = row.seeAll
            shelf.active = false
            shelf.items = content.getChild(index)
            shelf.observeField("itemSelected", "onHomeSelected")
            shelf.observeField("itemMenu", "onHomeMenu")
            shelf.observeField("endReached", "onHomeEnd")
            shelf.observeField("seeAllPressed", "onHomeSeeAll")
            Place(shelf, 0, y)
            y = y + shelf.shelfHeight
            m.shelves.push(shelf)
        end if
    end for
    if m.rows.count() = 0 and m.hero = invalid and not HomePending() then
        ' Home with nothing on it (screens/HomeEmpty.tsx).
        owner = false
        viewer = m.global.session.viewer
        if viewer <> invalid and viewer.viewer <> invalid then owner = viewer.viewer.role = "owner"
        state = m.body.createChild("UiStateView")
        state.icon = "home"
        state.title = T("web.empty.homeTitle")
        if owner then
            state.message = T("web.empty.homeOwnerBody")
        else
            state.message = T("web.empty.homeMemberBody")
        end if
        state.stateWidth = m.width
        Place(state, 0, y)
        y = y + state.boundingRect().height
    end if
    m.page.contentHeight = y + Theme.space.xxxl
    m.page.callFunc("refresh")
    ' A refresh keeps the viewer where they were: the same row and card.
    if had <> invalid and RestoreShelfState(had) then return
    if not m.claimed or had <> invalid then
        m.claimed = true
        NavClaimFocus()
    end if
end sub

function HomeHeroBuild(hero as object, top as dynamic) as float
    page = Theme.space.page
    column = Int(Theme.screen.width * Theme.apple.homeHeroWidthFraction) - page * 2
    cover = invalid
    textLeft = page
    copyWidth = column
    if hero.art = "cover" then
        cover = m.body.createChild("UiArtwork")
        cover.shape = hero.coverShape
        cover.title = hero.title
        cover.artWidth = Theme.apple.homeHeroCover
        cover.uri = hero.coverUri
        textLeft = page + Theme.apple.homeHeroCover + Theme.space.xl
        copyWidth = column - Theme.apple.homeHeroCover - Theme.space.xl
        m.backdrop.uri = ""
        m.backdrop.visible = true
    else
        m.backdrop.uri = hero.backdropUri
        m.backdrop.visible = true
    end if
    texts = []
    if hero.eyebrow <> invalid and hero.eyebrow <> "" then
        eyebrow = MakeText(m.body, "label", "tertiary", hero.eyebrow)
        eyebrow.maxWidth = copyWidth
        texts.push({ node: eyebrow, gap: 0 })
    end if
    title = MakeText(m.body, "display")
    title.lines = Theme.spec.hero.identity.titleLines
    title.maxWidth = copyWidth
    title.value = hero.title
    texts.push({ node: title, gap: Theme.space.xs })
    if hero.line <> invalid then
        line = MakeText(m.body, "heading", "primary", hero.line)
        line.maxWidth = copyWidth
        texts.push({ node: line, gap: Theme.space.xs })
    end if
    if hero.meta <> invalid then
        meta = MakeText(m.body, "body", "secondary", hero.meta)
        meta.maxWidth = copyWidth
        texts.push({ node: meta, gap: Theme.space.xs })
    end if
    copyHeight = 0
    for each item in texts
        copyHeight = copyHeight + item.gap + TextHeight(item.node)
    end for
    coverHeight = 0
    if cover <> invalid then coverHeight = Int(Theme.apple.homeHeroCover / ArtworkRatio(hero.coverShape) + 0.5)
    rowHeight = Max(copyHeight, coverHeight)

    overview = invalid
    overviewHeight = 0
    if hero.overview <> invalid and hero.overview <> "" then
        overview = MakeText(m.body, "body", "secondary")
        overview.lines = Theme.apple.homeHeroOverviewLines
        overview.maxWidth = Min(Theme.apple.homeHeroOverviewWidth, column)
        overview.value = hero.overview
        overviewHeight = Theme.space.sm + TextHeight(overview)
    end if
    bar = invalid
    barHeight = 0
    if hero.progress > 0 then
        bar = m.body.createChild("UiProgressBar")
        bar.barWidth = Theme.apple.homeHeroProgressWidth
        bar.value = hero.progress
        barHeight = Theme.space.md + Theme.apple.progressBarHeight
    end if
    m.play = invalid
    if hero.playEntry <> invalid then
        m.play = m.body.createChild("UiButton")
        m.play.variant = "primary"
        m.play.size = "lg"
        m.play.icon = "play"
        m.play.label = hero.playLabel
        m.play.observeField("pressed", "onHomePlay")
    end if
    details = m.body.createChild("UiButton")
    m.details = details
    details.variant = "secondary"
    details.size = "lg"
    details.icon = "info"
    details.label = T("action.details")
    details.observeField("pressed", "onHomeDetails")
    buttonsHeight = Theme.space.lg + details.controlHeight

    content = rowHeight + overviewHeight + barHeight + buttonsHeight
    height = Max(Theme.metrics.heroHeight, Theme.space.xxl + content + Theme.space.xl)
    ' Bottom-aligned (justifyContent: flex-end).
    y = top + height - Theme.space.xl - content
    if cover <> invalid then Place(cover, page, y + rowHeight - coverHeight)
    textY = y + rowHeight - copyHeight
    for each item in texts
        textY = textY + item.gap
        Place(item.node, textLeft, textY)
        textY = textY + TextHeight(item.node)
    end for
    y = y + rowHeight
    if overview <> invalid then
        Place(overview, page, y + Theme.space.sm)
        y = y + overviewHeight
    end if
    if bar <> invalid then
        Place(bar, page, y + Theme.space.md)
        y = y + barHeight
    end if
    y = y + Theme.space.lg
    if m.play <> invalid then
        Place(m.play, page, y)
        Place(details, page + m.play.controlWidth + Theme.space.sm, y)
    else
        Place(details, page, y)
    end if
    return height
end function

' The backdrop stays behind the rows while the page moves by focus; it fades as they cover it.
sub onHomeScroll()
    if not m.backdrop.visible then return
    reach = Theme.metrics.heroHeight
    fraction = 1 - m.page.scrollY / reach
    m.backdrop.opacity = Clamp(fraction, 0, 1)
end sub

function FocusedShelfState() as dynamic
    for each shelf in m.shelves
        if shelf.hasListFocus then
            row = m.rows[shelf.rowIndex]
            return { rowId: row.id, index: shelf.focusedIndex }
        end if
    end for
    return invalid
end function

function RestoreShelfState(state as object) as boolean
    for each shelf in m.shelves
        row = m.rows[shelf.rowIndex]
        if row.id = state.rowId then
            shelf.active = true
            shelf.callFunc("jumpTo", state.index)
            shelf.callFunc("focusList")
            m.page.callFunc("follow")
            return true
        end if
    end for
    return false
end function

function HomeShelfCurrent(shelf as object) as boolean
    if not HomeCurrent() then return false
    for each current in m.shelves
        if current.isSameNode(shelf) then return true
    end for
    return false
end function

function HomeEntry(shelf as object, index as integer) as dynamic
    items = shelf.items
    if items = invalid or index < 0 or index >= items.getChildCount() then return invalid
    return items.getChild(index).entry
end function

sub onHomeSelected(event as object)
    shelf = event.getRoSGNode()
    if not HomeShelfCurrent(shelf) then return
    entry = HomeEntry(shelf, event.getData())
    if entry = invalid then return
    row = m.rows[shelf.rowIndex]
    library = ""
    if row.libraryId <> invalid then library = row.libraryId
    OpenEntry(entry, "open", library)
end sub

sub onHomeMenu(event as object)
    shelf = event.getRoSGNode()
    if not HomeShelfCurrent(shelf) then return
    entry = HomeEntry(shelf, event.getData())
    if entry = invalid then return
    row = m.rows[shelf.rowIndex]
    library = ""
    if row.libraryId <> invalid then library = row.libraryId
    OpenEntry(entry, "more", library, row.origin)
end sub

sub onHomeSeeAll(event as object)
    shelf = event.getRoSGNode()
    if not HomeShelfCurrent(shelf) then return
    row = m.rows[shelf.rowIndex]
    if row.seeAllRoute = invalid then return
    if row.seeAllRoute.unavailable = true then
        Toast(PresentError({ code: "unavailable", status: 0 }, "home").body, "warning")
    else
        NavPush(row.seeAllRoute.screen, row.seeAllRoute.params)
    end if
end sub

sub onHomePlay(event as object)
    if not HomeCurrent() or m.play = invalid or not event.getRoSGNode().isSameNode(m.play) then return
    if not HomeViewerCurrent(m.homeBinding, ViewerRequestBinding(m.global.session.viewer)) or m.document = invalid or m.document.spotlight.count() = 0 then return
    spot = m.document.spotlight[0]
    if spot.playGranted <> true or m.hero = invalid or m.hero.entry.id <> spot.entry.id then return
    target = spot.entry
    if spot.resumeTarget <> invalid then target = spot.resumeTarget
    if target.playback <> invalid then OpenEntry(target, "play")
end sub

sub onHomeDetails(event as object)
    if not HomeCurrent() or m.details = invalid or not event.getRoSGNode().isSameNode(m.details) then return
    if not HomeViewerCurrent(m.homeBinding, ViewerRequestBinding(m.global.session.viewer)) or m.document = invalid or m.document.spotlight.count() = 0 then return
    spot = m.document.spotlight[0]
    if m.hero <> invalid and m.hero.entry.id = spot.entry.id then OpenEntry(spot.entry)
end sub

' The row's next page, by its own cursor, once per cursor.
sub onHomeEnd(event as object)
    shelf = event.getRoSGNode()
    if not HomeShelfCurrent(shelf) then return
    row = m.rows[shelf.rowIndex]
    if row.nextCursor = "" or m.paging[row.id] <> invalid then return
    if row.live <> invalid or row.collection <> invalid then return
    task = ApiStart({ path: HomeRowPagePath(row.id, row.nextCursor), reader: "homeRow", expectedViewer: m.homeBinding, context: { origin: m.homeBinding.origin, rowId: row.id, shape: row.shape, viewerFence: row.viewerFence, revision: row.revision } }, "onHomePage")
    task.addFields({ rowIndex: shelf.rowIndex, cursor: row.nextCursor, homeGeneration: m.homeGeneration, homeOpening: m.homeOpening, shelf: shelf })
    m.paging[row.id] = task
end sub

sub onHomePage(event as object)
    task = event.getRoSGNode()
    if not HomeCurrent() or task.homeGeneration <> m.homeGeneration or task.homeOpening <> m.homeOpening then return
    if not HomeShelfCurrent(task.shelf) then return
    result = event.getData()
    index = task.rowIndex
    if index >= m.rows.count() then return
    row = m.rows[index]
    held = m.paging[row.id]
    if held = invalid or not held.isSameNode(task) then return
    m.paging.delete(row.id)
    if not result.ok then
        ' A refused cursor means the row changed under the viewer: Home is read again.
        if result.error <> invalid and result.error.code = "stale_continuation" then HomeLoad(0)
        return
    end if
    if result.value.ok <> true then
        if result.value.code = "stale_continuation" then HomeLoad(0)
        return
    end if
    if row.nextCursor <> task.cursor then return
    shelf = task.shelf
    items = shelf.items
    seen = {}
    seen.setModeCaseSensitive()
    for each card in items.getChildren(-1, 0)
        seen[card.entryId] = true
    end for
    fresh = []
    limit = HomeRowMaxEntries()
    for each card in task.content.getChildren(-1, 0)
        if not seen.doesExist(card.entryId) and items.getChildCount() + fresh.count() < limit then
            seen[card.entryId] = true
            fresh.push(card)
        end if
    end for
    items.appendChildren(fresh)
    row.nextCursor = result.value.nextCursor
    if items.getChildCount() >= limit then row.nextCursor = ""
    row.total = result.value.total
    m.rows[index] = row
    for i = 0 to m.document.rows.count() - 1
        if m.document.rows[i].id = row.id then m.document.rows[i] = AppendHomeRowPage(m.document.rows[i], result.value.row)
    end for
end sub


' Shell calls retirement synchronously before hide/cover/drop/leave.
sub retireHome()
    m.homeActive = false
    HomeRetireHydrations()
    m.retry.control = "stop"
    if m.task <> invalid then m.task.control = "STOP"
    m.task = invalid
    m.document = invalid
end sub

sub HomeOpen()
    if not m.top.homePresented then return
    m.homeBinding = ViewerRequestBinding(m.global.session.viewer)
    if not HomeViewerCurrent(m.homeBinding, m.homeBinding) then return
    m.homeOpening = m.top.homeOpening
    m.homeActive = true
    HomeSkeleton()
    HomeLoad(0)
end sub

function HomeCurrent() as boolean
    if not m.homeActive or not m.top.homePresented or m.homeOpening <> m.top.homeOpening then return false
    return HomeViewerCurrent(m.homeBinding, ViewerRequestBinding(m.global.session.viewer))
end function

sub onHomeLiveExpiry()
    if HomeCurrent() and m.task = invalid then HomeLoad(0)
end sub
