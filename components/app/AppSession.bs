' apps/native/src/app/session.tsx, for the channel: one node the screens observe and call, as the
' Apple screens use `useSession()`. Each action runs its step in a Task (components/tasks) and
' publishes what the screens show. The steps and their rules are in source/core/Session.bs and
' source/core/Hosted.bs; the words for a failure come from source/core/Errors.bs.
import "pkg:/source/core/Errors.bs"
import "pkg:/source/core/Hosted.bs"
import "pkg:/source/core/HostedCredentialOwner.bs"
import "pkg:/source/core/TVSignIn.bs"
import "pkg:/source/core/TVConsent.bs"
import "pkg:/source/core/IdentityRecovery.bs"
import "pkg:/source/core/Messages.bs"

sub init()
    m.tasks = []
    m.credentials = invalid
    m.challengeToken = ""
    m.accountSession = invalid
    m.details = invalid
    m.afterConnect = invalid
    m.recoverySerial = 0
    m.accountCredentialTask = invalid
    m.accountCredentialTasks = []
end sub

sub SessionRun(job as object)
    if job.kind = "signIn" or job.kind = "challenge" or job.kind = "changePassword" or job.kind = "chooseProfile" or job.kind = "openServer" then job.expectedRevision = SessionRevision(SessionContextNew())
    if job.kind = "restore" or job.kind = "connect" or job.kind = "selectServer" then job.recoverySerial = m.recoverySerial
    task = CreateObject("roSGNode", "SessionTask")
    task.job = job
    task.observeField("result", "onSessionResult")
    m.tasks.push(task)
    m.top.busy = true
    task.control = "RUN"
end sub

sub onSessionResult(event as object)
    task = event.getRoSGNode()
    result = event.getData()
    kept = []
    for each running in m.tasks
        if not running.isSameNode(task) then kept.push(running)
    end for
    m.tasks = kept
    m.top.busy = m.tasks.count() > 0
    kind = result.kindOfJob
    if kind = "restore" or kind = "connect" or kind = "selectServer" then
        if result.recoverySerial <> m.recoverySerial then return
    end if
    if kind = "retryIdentity" or kind = "forgetIdentity" then
        if result.recoverySerial <> m.recoverySerial or m.top.phase <> "identity" then return
        if kind = "forgetIdentity" then
            if result.ok then
                m.top.connection = invalid
                m.top.connected = false
                m.top.viewer = invalid
                m.top.token = ""
                m.top.origin = ""
                m.top.username = ""
                m.top.note = ""
                useElsewhere()
            end if
        else if result.source = "connect" then
            SessionConnected(result)
            if result.ok then
                m.top.hasRecovery = false
                m.top.phase = "signedOut"
            end if
        else
            if result.ok then SessionRestored(result)
        end if
        return
    else if kind = "reviewTVConsent" then
        if result.ok then
            m.reviewedConsent = result.reviewed
            m.top.tvConsent = result.reviewed.preview
        else
            m.top.error = SignInMessage(result.failure)
        end if
    else if kind = "decideTVConsent" then
        m.reviewedConsent = invalid
        m.top.tvConsent = invalid
        if not result.ok then m.top.error = SignInMessage(result.failure)
    else if kind = "restore" then
        SessionRestored(result)
    else if kind = "connect" then
        SessionConnected(result)
    else if kind = "signIn" or kind = "challenge" or kind = "changePassword" or kind = "chooseProfile" then
        SessionOutcome(result)
    else if kind = "profiles" then
        if result.ok then
            m.top.pending = { snapshot: result.snapshot, accountSession: { accessToken: m.top.viewer.token }, switching: true }
            m.top.hasPending = true
        else
            m.top.error = PresentError(result.failure, "profiles", { operation: "load" }).body
        end if
    else if kind = "servers" then
        SessionServers(result)
    else if kind = "openServer" then
        SessionOpened(result)
    else if kind = "selectServer" then
        SessionRestored(result)
    else if kind = "signOut" or kind = "signOutAccount" then
        if kind = "signOutAccount" and result.record <> invalid then
            m.top.hasAccount = false
            m.top.account = invalid
            m.top.servers = []
            return
        end if
        SessionSignedOut(kind = "signOutAccount")
    end if
end sub

sub restore()
    m.top.error = ""
    SessionRun({ kind: "restore" })
end sub

sub SessionRestored(result as object)
    if result.hosted <> invalid then
        m.top.account = result.hosted.account
        m.top.hasAccount = true
    end if
    state = result.state
    if state = "ready" then
        SessionReady(result.record, result.session, result.connection)
        return
    end if
    record = result.record
    if record <> invalid then
        if record["signIn"] = "local" then m.top.accountRequested = false
        m.top.origin = record["logicalOrigin"]
        if record["username"] <> invalid then m.top.username = record["username"]
    end if
    if state = "offline" then
        name = ""
        if record["serverName"] <> invalid then name = record["serverName"]
        m.top.recovery = { origin: record["logicalOrigin"], serverName: name }
        if result.failure <> invalid and result.failure.code = "certificate_unsupported" then m.top.recovery = { origin: record["logicalOrigin"], serverName: name, certificateUnsupported: true }
        m.top.hasRecovery = true
        m.top.phase = "unavailable"
        return
    end if
    if state = "changed" or state = "unconfirmed" then
        SessionShowIdentity(IdentityRecovery(SessionContextNew(), record, state, "restore"))
        return
    end if
    m.top.hasRecovery = false
    if state = "ended" or state = "refused" then
        ' The sign-in screen opens with the server and username filled in, and says why, quietly.
        if result.failure <> invalid then m.top.note = SignInMessage(result.failure)
        if m.top.note = "" then m.top.note = T("error.authentication")
    end if
    m.top.phase = "signedOut"
    if m.top.hasAccount and m.top.accountRequested then refreshServers()
end sub

sub SessionReady(record as dynamic, session as object, connection as object)
    m.top.accountRequested = connection.signIn = "portico"
    viewer = { origin: connection.origin, token: session.accessToken, serverId: connection.pin.serverId, sessionFamilyId: session.sessionFamilyId, viewer: session.viewer, profileName: "", serverName: "", username: "", signIn: connection.signIn }
    if record <> invalid then
        if record["profileName"] <> invalid then viewer.profileName = record["profileName"]
        if record["serverName"] <> invalid then viewer.serverName = record["serverName"]
        if record["username"] <> invalid then viewer.username = record["username"]
        viewer.capabilities = record["capabilities"]
    end if
    m.credentials = invalid
    m.accountSession = invalid
    m.top.connection = connection
    m.top.token = session.accessToken
    m.top.viewer = viewer
    m.top.error = ""
    m.top.note = ""
    m.top.directStep = ""
    m.top.hasPending = false
    m.top.hasRecovery = false
    m.top.switching = false
    m.switchBack = invalid
    m.top.phase = "ready"
end sub

sub setOrigin(text as string)
    if text = m.top.origin then return
    m.top.origin = text
    m.top.connection = invalid
    m.top.connected = false
end sub

' Proves the server at the typed address (no credential is sent).
sub connect()
    if m.top.origin.trim() = "" or m.top.busy then return
    m.top.error = ""
    m.afterConnect = invalid
    SessionRun({ kind: "connect", address: m.top.origin, pin: invalid })
end sub

sub SessionConnected(result as object)
    if not result.ok then
        m.afterConnect = invalid
        if IsString(result.failure.savedServerId) then
            ctx = SessionContextNew()
            record = SessionRecord(ctx, result.failure.savedServerId)
            if record <> invalid then
                SessionShowIdentity(IdentityRecovery(ctx, record, "changed", "connect", m.top.origin))
                return
            end if
        end if
        m.top.error = SignInMessage(result.failure)
        return
    end if
    m.top.connection = result.connection
    if result.connection.signIn = "portico" then
        m.afterConnect = invalid
        m.credentials = invalid
        m.porticoTarget = result.connection.pin.serverId
        m.top.note = T("accounts.signIn.usesPortico", { server: result.connection.serverName })
        m.top.accountRequested = true
        if m.top.hasAccount then refreshServers()
        return
    end if
    if m.afterConnect <> invalid then
        job = m.afterConnect
        m.afterConnect = invalid
        job.connection = result.connection
        SessionRun(job)
        return
    end if
    m.top.connected = true
end sub

' {username, password}: a direct sign-in to the server at the typed address.
sub signIn(credentials as object)
    if m.top.busy then return
    if credentials.expectedConnection <> invalid then
        if not TVSignInLocalCurrent(credentials.expectedConnection, m.top.connection) then return
    end if
    m.top.error = ""
    m.top.directFailure = invalid
    m.credentials = credentials
    m.details = invalid
    job = { kind: "signIn", connection: m.top.connection, username: credentials.username, password: credentials.password }
    if m.top.connection = invalid then
        m.afterConnect = job
        SessionRun({ kind: "connect", address: m.top.origin, pin: invalid })
    else
        SessionRun(job)
    end if
end sub

sub SessionOutcome(result as object)
    if not result.ok then
        m.top.directFailure = result.failure
        m.top.error = SignInMessage(result.failure)
        return
    end if
    kind = result.kind
    if kind = "ready" then
        SessionReady(result.record, result.session, result.connection)
    else if kind = "two-step-setup" then
        ' This restricted account is retained privately. Roku offers no owner enrollment
        ' page and cannot turn it into a profile/viewer or management grant.
        m.accountSession = result.accountSession
        m.top.directFailure = { code: "two_step_setup_required", status: 0, message: "" }
        m.top.error = SignInMessage(m.top.directFailure)
    else if kind = "profiles" then
        m.top.directStep = ""
        m.top.pending = { snapshot: result.snapshot, accountSession: result.accountSession, switching: false }
        m.top.hasPending = true
    else if kind = "password-change" then
        m.accountSession = result.accountSession
        m.top.directStep = "password-change"
    else if kind = "challenge" then
        m.challengeToken = result.token
        m.top.directStep = "challenge"
    end if
end sub

sub completeChallenge(code as string)
    if m.top.busy then return
    m.top.error = ""
    m.top.directFailure = invalid
    username = ""
    if m.credentials <> invalid then username = m.credentials.username
    SessionRun({ kind: "challenge", connection: m.top.connection, token: m.challengeToken, code: code, username: username })
end sub

sub changeRequiredPassword(newPassword as string)
    if m.top.busy or m.credentials = invalid or m.accountSession = invalid then return
    m.top.error = ""
    SessionRun({ kind: "changePassword", connection: m.top.connection, accountSession: m.accountSession, username: m.credentials.username, currentPassword: m.credentials.password, newPassword: newPassword })
    m.credentials = { username: m.credentials.username, password: newPassword }
end sub

sub cancelStep()
    SessionAdvance(SessionContextNew())
    m.top.directStep = ""
    m.top.error = ""
    m.top.directFailure = invalid
    m.challengeToken = ""
    m.accountSession = invalid
    m.credentials = invalid
    m.details = invalid
end sub

' {profileId, pin}
sub chooseProfile(choice as object)
    if m.top.busy or not m.top.hasPending then return
    m.top.error = ""
    pin = ""
    if choice.pin <> invalid then pin = choice.pin
    SessionRun({ kind: "chooseProfile", connection: m.top.connection, pending: m.top.pending, profileId: choice.profileId, pin: pin, details: m.details })
end sub

sub cancelPending()
    m.top.hasPending = false
    m.top.error = ""
end sub

' The profile chooser while signed in (Settings › Switch profile).
' apps/native/src/screens/SettingsPages.tsx `ServersScreen`: another of the account's servers, or
' a server by its address. The sign-in in use stays until another one replaces it; Back returns
' to it.
sub switchServer()
    if m.top.phase <> "ready" or m.top.busy or m.top.switching then return
    m.switchBack = { connection: m.top.connection, origin: m.top.origin }
    m.top.error = ""
    m.top.note = ""
    if m.top.hasAccount and m.top.accountRequested then
        pickServer()
        refreshServers()
    end if
    m.top.switching = true
end sub

sub selectServer(serverId as string)
    if m.top.busy then return
    m.top.switching = true
    SessionRun({ kind: "selectServer", serverId: serverId })
end sub

sub cancelSwitch()
    if not m.top.switching then return
    if m.switchBack <> invalid then
        m.top.connection = m.switchBack.connection
        m.top.origin = m.switchBack.origin
    end if
    m.switchBack = invalid
    m.top.directStep = ""
    m.top.error = ""
    m.top.switching = false
end sub

sub switchProfile()
    if m.top.phase <> "ready" or m.top.busy then return
    SessionRun({ kind: "profiles", connection: m.top.connection, token: m.top.viewer.token })
end sub

' A server sign-in a code approved (Quick Connect): the Task has already saved it.
sub acceptOutcome(outcome as object)
    if outcome.ok then
        SessionReady(outcome.record, outcome.session, outcome.connection)
    else
        m.top.error = SignInMessage(outcome.failure)
    end if
end sub

' The account's activation code was approved.
sub accountApproved(account as object)
    m.top.account = account
    m.top.hasAccount = true
    m.top.accountRequested = true
    m.top.landing = { kind: "deciding" }
    refreshServers()
end sub

' The renderer sends one password or factor submission. Native continuation/challenge tokens
' remain in HostedCredentialTask, which persists the family before returning its summary.
sub beginAccountCredentials()
    if m.accountCredentialTask <> invalid or m.top.hasAccount then return
    task = CreateObject("roSGNode", "HostedCredentialTask")
    task.observeField("credentialState", "onAccountCredentialState")
    task.observeField("outcome", "onAccountCredentialOutcome")
    m.accountCredentialTask = task
    m.accountCredentialTasks.push(task)
    m.top.accountCredentialState = { phase: "starting" }
    task.control = "RUN"
end sub

sub submitAccountCredentials(input as object)
    if m.accountCredentialTask = invalid then return
    state = m.top.accountCredentialState
    if state <> invalid and (state.phase = "starting" or state.phase = "working") then return
    if input.kind <> "login" and input.kind <> "mfa" then return
    m.top.accountCredentialState = { phase: "working" }
    m.accountCredentialTask.submission = input
end sub

sub cancelAccountCredentials()
    if m.accountCredentialTask <> invalid then
        m.accountCredentialTask.unobserveField("credentialState")
        m.accountCredentialTask.command = "stop"
        m.accountCredentialTask = invalid
    end if
    m.top.accountCredentialState = invalid
end sub

sub onAccountCredentialState(event as object)
    if m.accountCredentialTask = invalid then return
    if not m.accountCredentialTask.isSameNode(event.getRoSGNode()) then return
    m.top.accountCredentialState = event.getData()
end sub

sub onAccountCredentialOutcome(event as object)
    task = event.getRoSGNode()
    result = event.getData()
    kept = []
    for each running in m.accountCredentialTasks
        if not running.isSameNode(task) then kept.push(running)
    end for
    m.accountCredentialTasks = kept
    task.unobserveField("credentialState")
    task.unobserveField("outcome")
    if m.accountCredentialTask = invalid then
        task.command = "stop"
        return
    end if
    if not m.accountCredentialTask.isSameNode(task) then
        task.command = "stop"
        return
    end if
    m.accountCredentialTask = invalid
    if result.ok and result.kind = "signed-in" then
        if not HostedCredentialAcceptancePending(task.credentialState, NowSeconds()) then
            task.command = "stop"
            m.top.accountCredentialState = { phase: "error", failure: { code: "cancelled", status: 0, message: "" } }
            return
        end if
        task.command = "accept"
        m.top.accountCredentialState = invalid
        accountApproved(result.account)
    else
        m.top.accountCredentialState = { phase: "error", failure: result.failure }
    end if
end sub

sub requestAccount()
    m.top.accountRequested = true
    if m.top.hasAccount then refreshServers()
end sub

sub refreshServers()
    m.top.directoryStatus = "loading"
    SessionRun({ kind: "servers" })
end sub

sub SessionServers(result as object)
    if not result.ok then
        if result.signOut = true then
            m.top.hasAccount = false
            m.top.note = T("error.authentication")
            m.top.directoryStatus = "idle"
            return
        end if
        m.top.servers = []
        m.top.error = PresentError(result.failure, "portico-account").body
        m.top.directoryStatus = "error"
        m.top.landing = { kind: "none" }
        return
    end if
    m.top.servers = result.servers
    m.top.directoryStatus = "ready"
    if m.porticoTarget <> invalid then
        target = m.porticoTarget
        m.porticoTarget = invalid
        for each server in result.servers
            if server.id = target then
                openServer(server)
                return
            end if
        end for
        m.top.landing = { kind: "none" }
        m.top.error = T("portico.landing.noAccess")
        return
    end if
    landing = m.top.landing
    ' Decide once the list is known; again if a list that was empty gains a server.
    if landing = invalid or landing.kind = "deciding" or (landing.kind = "none" and result.servers.count() > 0) then
        choice = LandingChoice(result.servers, result.lastServer)
        if choice.kind = "open" then
            openServer(choice.server)
        else
            m.top.landing = { kind: choice.kind }
        end if
    end if
end sub

sub openServer(server as object)
    m.top.error = ""
    m.pendingServer = server
    m.top.landing = { kind: "opening", server: server }
    SessionRun({ kind: "openServer", server: server })
end sub

sub pickServer()
    m.pendingServer = invalid
    m.top.directStep = ""
    m.top.landing = { kind: "pick" }
end sub

sub SessionOpened(result as object)
    server = m.pendingServer
    if result.ok then
        m.top.connection = result.connection
        m.details = result.details
        m.pendingServer = invalid
        SessionOutcome(result)
        return
    end if
    if result.signOut = true then
        m.top.hasAccount = false
        m.top.note = T("error.authentication")
        return
    end if
    stage = "route"
    if result.stage <> invalid then stage = result.stage
    category = PresentErrorFacts(result.failure, "sign-in", { service: "server" }).category
    kind = ClassifyPorticoFailure(result.failure, stage, category)
    code = ""
    if result.failure.code <> invalid then code = result.failure.code
    m.top.landing = { kind: "failed", server: server, failure: { kind: kind, code: code } }
end sub

sub signOut()
    if m.top.busy or m.top.viewer = invalid then return
    record = SessionRecord(SessionContextNew(), m.top.viewer.serverId)
    if record = invalid then return
    SessionRun({ kind: "signOut", serverId: record["pin"].serverId, familyId: record["session"].sessionFamilyId })
end sub

sub signOutAccount()
    if m.top.busy then return
    if m.top.account = invalid then return
    SessionRun({ kind: "signOutAccount", accountId: m.top.account.id })
end sub

sub SessionSignedOut(account as boolean)
    m.top.accountRequested = false
    m.top.viewer = invalid
    m.top.connection = invalid
    m.top.connected = false
    m.top.hasPending = false
    m.top.directStep = ""
    m.top.error = ""
    if account then
        m.top.hasAccount = false
        m.top.account = invalid
        m.top.servers = []
    end if
    m.top.phase = "signedOut"
end sub

' "Use another server or account" from the saved-server screen: the sign-in screens open, and the
' saved server stays reachable from them.
sub useElsewhere()
    SessionAdvance(SessionContextNew())
    m.recoverySerial = m.recoverySerial + 1
    m.top.hasRecovery = false
    m.top.recovery = invalid
    m.top.phase = "signedOut"
end sub

sub SessionShowIdentity(recovery as dynamic)
    if recovery = invalid then return
    m.recoverySerial = m.recoverySerial + 1
    m.credentials = invalid
    m.afterConnect = invalid
    m.top.recovery = recovery
    m.top.hasRecovery = true
    m.top.phase = "identity"
end sub

sub retryIdentity()
    if m.top.busy or m.top.phase <> "identity" then return
    SessionRun({ kind: "retryIdentity", recovery: m.top.recovery, recoverySerial: m.recoverySerial })
end sub

sub forgetIdentity(captured as object)
    if m.top.busy or m.top.phase <> "identity" then return
    if not IdentityRecoveryMatches(captured, m.top.recovery) then return
    SessionRun({ kind: "forgetIdentity", recovery: captured, recoverySerial: m.recoverySerial })
end sub


' Headless seam for the forthcoming code-entry consumer; screens never choose another account
' or forge review payloads. The current code/confirmation frames remain held.
sub reviewTVConsent(input as object)
    if m.top.busy then return
    m.reviewedConsent = invalid
    m.top.tvConsent = invalid
    SessionRun({ kind: "reviewTVConsent", authorityKind: input.kind, code: input.code })
end sub

sub decideTVConsent(decision as string)
    if m.top.busy or m.reviewedConsent = invalid then return
    reviewed = m.reviewedConsent
    m.reviewedConsent = invalid
    SessionRun({ kind: "decideTVConsent", reviewed: reviewed, decision: decision })
end sub

sub cancelTVConsent()
    m.reviewedConsent = invalid
    m.top.tvConsent = invalid
    TVConsentCancel(SessionContextNew())
end sub

sub clearError()
    m.top.error = ""
end sub
