import "pkg:/source/core/HostedCredentialOwner.bs"

sub Test_HostedCredentialOwner_delayedSceneEventCannotAcceptAnExpiredOrRetiringGrant()
    ctx = TestContext()
    deadline = HostedCredentialAcceptanceDeadline(ctx)
    state = { phase: "awaiting-accept", acceptBySeconds: deadline }
    AssertTrue(HostedCredentialAcceptancePending(state, deadline - 1))
    AssertEqual(HostedCredentialAcceptancePending(state, deadline), false)
    AssertEqual(HostedCredentialAcceptancePending(state, deadline + 1), false)
    AssertEqual(HostedCredentialAcceptancePending({ phase: "retiring", acceptBySeconds: deadline }, ctx.now), false)
    AssertEqual(HostedCredentialAcceptancePending({ phase: "awaiting-accept", acceptBySeconds: "later" }, ctx.now), false)
    AssertEqual(HostedCredentialAcceptancePending(invalid, ctx.now), false)
end sub

sub Test_HostedCredentialOwner_actualLoginPersistsBeforeSummaryPublication()
    ctx = TestContext()
    ctx.admissionRevision = SessionRevision(ctx)
    owner = HostedCredentialOwnerNew(ctx)
    client = HostedCredentialsNew(ctx, TestHostedCredentialBinding(), owner)
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions", 200, TestGrant())
    answer = client.login("priya.n", "test-password", ctx.requestId)
    AssertEqual(HostedLoad(ctx).refreshToken, TestGrant().refreshToken)
    result = HostedCredentialOwnerComplete(owner, answer)
    AssertTrue(result.ok)
    AssertTrue(HasExactKeys(result, ["ok", "kind", "account", "familyId"]))
    AssertEqual(result.account.id, TestGrant().account.id)
    AssertEqual(result.familyId, TestGrant().familyId)
    AssertEqual(SessionRevision(ctx), 1)
    AssertEqual(HostedCredentialOwnerNew(ctx), invalid, "an active account requires explicit sign-out before a new credential owner")
end sub

sub Test_HostedCredentialOwner_mfaContinuationAdmitsOnlyAfterTheActualFactorResponse()
    ctx = TestContext()
    owner = HostedCredentialOwnerNew(ctx)
    client = HostedCredentialsNew(ctx, TestHostedCredentialBinding(), owner)
    challenge = { mfaRequired: true, challengeId: "challenge_1", challengeToken: "private-test-challenge", expiresAt: "2099-01-01T00:00:00Z" }
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions", 200, challenge)
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/identity/mfa/complete", 200, TestGrant())
    first = client.login("priya.n", "test-password", ctx.requestId)
    AssertEqual(first.kind, "challenge")
    AssertEqual(HostedLoad(ctx), invalid)
    AssertEqual(SessionRevision(ctx), 0)
    AssertEqual(first.challengeToken, invalid)
    result = HostedCredentialOwnerComplete(owner, client.mfa("123456"))
    AssertEqual(result.kind, "signed-in")
    AssertEqual(HostedLoad(ctx).familyId, TestGrant().familyId)
    AssertEqual(ctx.transport.requests[1].headers["X-Portico-Continuation"], TestHostedCredentialBinding())
    AssertEqual(ParseJson(ctx.transport.requests[1].body).challengeToken, challenge.challengeToken)
end sub

sub Test_HostedCredentialOwner_failedRevisionCommitNeverPublishesAdmission()
    ctx = TestContext()
    owner = HostedCredentialOwnerNew(ctx)
    AssertTrue(owner.admitGrant(TestGrant()).ok)
    TestHostedFailWrite(ctx, "sessionRevision", true)
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions/revoke", 204)
    result = HostedCredentialOwnerComplete(owner, { ok: true, kind: "signed-in" })
    AssertEqual(result.failure.code, "persistence_error")
    AssertEqual(result.account, invalid)
    AssertEqual(HostedLoad(ctx), invalid)
    AssertEqual(ParseJson(ctx.transport.requests[0].body).refreshToken, TestGrant().refreshToken)
end sub

sub Test_HostedCredentialOwner_failedAdmissionQueuesExactAuthorityAndRetriesAfterRestart()
    ctx = TestContext()
    owner = HostedCredentialOwnerNew(ctx)
    client = HostedCredentialsNew(ctx, TestHostedCredentialBinding(), owner)
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions", 200, TestGrant())
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions/revoke", 503)
    TestHostedFailWrite(ctx, "hosted", true)
    answer = client.login("priya.n", "test-password", ctx.requestId)
    AssertEqual(answer.failure.code, "persistence_error")
    AssertEqual(HostedLoad(ctx), invalid)
    queued = StoreReadJson(ctx.store, "portico.hosted.retirements", "family." + TestGrant().familyId)
    AssertTrue(HasExactKeys(queued, ["origin", "accountId", "familyId", "refreshToken"]))
    AssertEqual(queued.origin, ctx.hostedUrl)
    AssertEqual(queued.refreshToken, TestGrant().refreshToken)
    AssertEqual(SessionRevision(ctx), 0)
    restarted = TestContext()
    restarted.store = ctx.store
    TestAnswer(restarted, "POST", restarted.hostedUrl + "/v1/sessions/revoke", 204)
    AssertTrue(HostedRetryRetirements(restarted, restarted.hostedUrl))
    AssertEqual(restarted.store.keys("portico.hosted.retirements").count(), 0)
    sent = restarted.transport.requests[0]
    AssertEqual(ParseJson(sent.body).refreshToken, TestGrant().refreshToken)
    AssertEqual(sent.headers.Authorization, invalid)
end sub

sub Test_HostedCredentialOwner_cancellationAfterSaveRetiresOnlyItsOwnFamily()
    for each replaced in [false, true]
        ctx = TestContext()
        ctx.task = { command: "", state: "run" }
        owner = HostedCredentialOwnerNew(ctx)
        AssertTrue(owner.admitGrant(TestGrant()).ok)
        if replaced then StoreWriteJson(ctx.store, "portico", "hosted", TestHostedNewFamily())
        ctx.task.command = "stop"
        TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions/revoke", 204)
        result = HostedCredentialOwnerComplete(owner, { ok: true, kind: "signed-in" })
        AssertEqual(result.failure.code, "cancelled")
        current = HostedLoad(ctx)
        if replaced then
            AssertEqual(current.familyId, TestHostedNewFamily().familyId)
        else
            AssertEqual(current, invalid)
        end if
        AssertEqual(ParseJson(ctx.transport.requests[0].body).refreshToken, TestGrant().refreshToken)
    end for
end sub

sub Test_HostedCredentialOwner_lateResponseCannotReplaceAnotherActiveFamily()
    ctx = TestContext()
    owner = HostedCredentialOwnerNew(ctx)
    StoreWriteJson(ctx.store, "portico", "hosted", TestHostedNewFamily())
    AssertEqual(owner.admitGrant(TestGrant()).failure.code, "account_changed")
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions/revoke", 204)
    owner.retireLateGrant(TestGrant())
    AssertEqual(HostedLoad(ctx).familyId, TestHostedNewFamily().familyId)
    AssertEqual(ParseJson(ctx.transport.requests[0].body).refreshToken, TestGrant().refreshToken)
end sub

sub Test_HostedCredentialOwner_alreadyAdmittedExactGrantIsNotRetiredByAnotherAttempt()
    ctx = TestContext()
    owner = HostedCredentialOwnerNew(ctx)
    StoreWriteJson(ctx.store, "portico", "hosted", TestGrant())
    owner.retireLateGrant(TestGrant())
    AssertEqual(ctx.transport.requests.count(), 0)
    AssertEqual(ctx.store.keys("portico.hosted.retirements").count(), 0)
    AssertEqual(HostedLoad(ctx).familyId, TestGrant().familyId)
end sub

sub Test_HostedCredentialOwner_originAndRevisionFenceBeforeAdmission()
    for each changedOrigin in [false, true]
        ctx = TestContext()
        owner = HostedCredentialOwnerNew(ctx)
        origin = ctx.hostedUrl
        if changedOrigin then
            ctx.hostedUrl = "https://different.example.com"
        else
            SessionAdvance(ctx)
        end if
        AssertEqual(owner.admitGrant(TestGrant()).failure.code, "account_changed")
        TestAnswer(ctx, "POST", origin + "/v1/sessions/revoke", 204)
        owner.retireLateGrant(TestGrant())
        AssertEqual(HostedLoad(ctx), invalid)
        AssertEqual(ctx.transport.requests[0].url, origin + "/v1/sessions/revoke")
    end for
end sub

sub Test_HostedCredentialOwner_unknownRetirementIsPreservedAndNeverSent()
    ctx = TestContext()
    authority = { origin: "https://different.example.com", accountId: "acct_1", familyId: "family_1", refreshToken: "test-refresh" }
    StoreWriteJson(ctx.store, "portico.hosted.retirements", "family.family_1", authority)
    AssertEqual(HostedRetryRetirements(ctx, ctx.hostedUrl), false)
    AssertEqual(ctx.transport.requests.count(), 0)
    AssertEqual(ctx.store.keys("portico.hosted.retirements").count(), 1)
end sub
