import "pkg:/source/core/HostedCredentials.bs"

function TestHostedCredentialOwner() as object
    return {
        current: true, accepted: true, admissions: [], retirements: []
        isCurrent: function() as boolean
            return m.current
        end function
        admitGrant: function(grant as object) as object
            m.admissions.push(grant)
            return { ok: m.accepted }
        end function
        retireLateGrant: sub(grant as object)
            m.retirements.push(grant)
        end sub
    }
end function

function TestHostedCredentialBinding() as string
    return "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
end function

sub Test_HostedCredentials_actualLoginWireDelegatesAdmission()
    ctx = TestContext()
    owner = TestHostedCredentialOwner()
    client = HostedCredentialsNew(ctx, TestHostedCredentialBinding(), owner)
    grant = TestGrant()
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions", 200, grant)
    result = client.login("priya.n", "a-test-password", ctx.requestId)
    AssertTrue(result.ok)
    AssertEqual(result.kind, "signed-in")
    AssertEqual(result.account.id, grant.account.id)
    AssertEqual(owner.admissions.count(), 1)
    AssertEqual(owner.retirements.count(), 0)
    AssertEqual(HostedLoad(ctx), invalid, "the headless transport creates no parallel credential store")
    sent = ctx.transport.requests[0]
    AssertEqual(sent.headers["X-Portico-Continuation"], TestHostedCredentialBinding())
    AssertEqual(sent.headers.Authorization, invalid)
    body = ParseJson(sent.body)
    AssertTrue(HasExactKeys(body, ["username", "password", "requestId", "sessionMode"]))
    AssertEqual(body.sessionMode, "native")
    AssertEqual(body.requestId, ctx.requestId)
    AssertEqual(body.username, "priya.n")
    AssertEqual(client.binding, "")
    AssertEqual(client.challenge, invalid)
    AssertEqual(client.login("priya.n", "a-test-password", ctx.requestId).failure.code, "cancelled")
    AssertEqual(client.mfa("123456").failure.code, "cancelled")
    AssertEqual(ctx.transport.requests.count(), 1)
end sub

sub Test_HostedCredentials_mfaUsesTheSameNativeBindingAndNoPasswordReplay()
    ctx = TestContext()
    owner = TestHostedCredentialOwner()
    client = HostedCredentialsNew(ctx, TestHostedCredentialBinding(), owner)
    challenge = { mfaRequired: true, challengeId: "challenge_1", challengeToken: "private-test-challenge", expiresAt: "2099-01-01T00:00:00Z" }
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions", 200, challenge)
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/identity/mfa/complete", 200, TestGrant())
    first = client.login("priya.n", "a-test-password", ctx.requestId)
    AssertEqual(first.kind, "challenge")
    AssertEqual(first.challengeToken, invalid, "renderer-facing outcome excludes challenge authority")
    AssertEqual(owner.admissions.count(), 0)
    AssertEqual(client.login("priya.n", "a-test-password", ctx.requestId).failure.code, "challenge_in_progress")
    complete = client.mfa("123456")
    AssertEqual(complete.kind, "signed-in")
    AssertEqual(ctx.transport.requests.count(), 2)
    sent = ctx.transport.requests[1]
    AssertEqual(sent.headers["X-Portico-Continuation"], TestHostedCredentialBinding())
    body = ParseJson(sent.body)
    AssertTrue(HasExactKeys(body, ["challengeId", "challengeToken", "factor"]))
    AssertEqual(body.challengeId, "challenge_1")
    AssertEqual(body.challengeToken, "private-test-challenge")
    AssertEqual(body.factor, "123456")
    AssertEqual(owner.admissions.count(), 1)
    AssertEqual(client.challenge, invalid)
end sub

function TestHostedCredentialLateSend(request as object) as object
    m.transport.requests.push(request)
    SessionAdvance(m.transport.ctx)
    return { status: 200, headers: {}, body: FormatJson(TestGrant()), failure: "" }
end function

sub Test_HostedCredentials_lateGrantRetiresAtTheCapturedOwner()
    ctx = TestContext()
    owner = TestHostedCredentialOwner()
    client = HostedCredentialsNew(ctx, TestHostedCredentialBinding(), owner)
    ctx.transport.ctx = ctx
    ctx.send = TestHostedCredentialLateSend
    result = client.login("priya.n", "a-test-password", ctx.requestId)
    AssertEqual(result.failure.code, "cancelled")
    AssertEqual(owner.admissions.count(), 0)
    AssertEqual(owner.retirements.count(), 1)
    AssertEqual(owner.retirements[0].familyId, TestGrant().familyId)
    AssertEqual(HostedLoad(ctx), invalid)
end sub

sub Test_HostedCredentials_failedAdmissionCompensatesWithoutChangingOldSession()
    ctx = TestContext()
    old = TestGrant()
    HostedSave(ctx, old)
    owner = TestHostedCredentialOwner()
    owner.accepted = false
    client = HostedCredentialsNew(ctx, TestHostedCredentialBinding(), owner)
    fresh = TestGrant()
    fresh.familyId = "fresh_family"
    TestAnswer(ctx, "POST", ctx.hostedUrl + "/v1/sessions", 200, fresh)
    AssertEqual(client.login("priya.n", "a-test-password", ctx.requestId).failure.code, "persistence_error")
    AssertEqual(owner.retirements.count(), 1)
    AssertEqual(owner.retirements[0].familyId, "fresh_family")
    AssertEqual(HostedLoad(ctx).familyId, old.familyId)
    AssertEqual(client.binding, "")
end sub

sub Test_HostedCredentials_cancellationOriginExpiryAndBindingRejectBeforeIO()
    ctx = TestContext()
    owner = TestHostedCredentialOwner()
    AssertEqual(HostedCredentialsNew(ctx, "", owner), invalid)
    AssertEqual(HostedCredentialsNew(ctx, TestHostedCredentialBinding(), {}), invalid)
    client = HostedCredentialsNew(ctx, TestHostedCredentialBinding(), owner)
    ctx.hostedUrl = "https://another.example.com"
    AssertEqual(client.login("priya.n", "a-test-password", ctx.requestId).failure.code, "cancelled")
    ctx.hostedUrl = client.origin
    client.challenge = { mfaRequired: true, challengeId: "c", challengeToken: "test", expiresAt: "2000-01-01T00:00:00Z" }
    AssertEqual(client.mfa("123456").failure.code, "challenge_expired")
    owner.current = false
    AssertEqual(client.login("priya.n", "a-test-password", ctx.requestId).failure.code, "cancelled")
    AssertEqual(ctx.transport.requests.count(), 0)
    AssertEqual(ParseHostedMFAChallenge({ mfaRequired: true, challengeId: "c", challengeToken: "test", expiresAt: "2099-01-01T00:00:00+00:00" }, ctx.now).ok, false)
end sub
