' ui/Focus.bs: the geometry that chooses where the remote goes.

function TestRect(x as integer, y as integer, width as integer, height as integer) as object
    return { x: x, y: y, width: width, height: height }
end function

sub Test_Focus_nearestInTheBeamWins()
    current = TestRect(100, 100, 200, 64)
    candidates = [TestRect(320, 100, 200, 64), TestRect(540, 100, 200, 64), TestRect(100, 200, 200, 64)]
    AssertEqual(FocusPick(current, candidates, "right"), 0)
    AssertEqual(FocusPick(current, candidates, "down"), 2)
    AssertEqual(FocusPick(current, candidates, "left"), -1)
    AssertEqual(FocusPick(current, candidates, "up"), -1)
end sub

sub Test_Focus_beamBeatsDistance()
    ' A far control straight below beats a near one off to the side.
    current = TestRect(100, 100, 200, 64)
    candidates = [TestRect(400, 180, 200, 64), TestRect(120, 600, 200, 64)]
    AssertEqual(FocusPick(current, candidates, "down"), 1)
end sub

sub Test_Focus_outsideTheBeamStillReachable()
    current = TestRect(100, 100, 200, 64)
    candidates = [TestRect(400, 300, 200, 64), TestRect(900, 300, 200, 64)]
    AssertEqual(FocusPick(current, candidates, "down"), 0)
end sub

sub Test_Focus_tieGoesToTheSmallerOffset()
    current = TestRect(300, 100, 200, 64)
    candidates = [TestRect(0, 200, 400, 64), TestRect(280, 200, 240, 64)]
    AssertEqual(FocusPick(current, candidates, "down"), 1)
end sub

sub Test_Focus_overlappingControlBehindIsNotAhead()
    ' A control that starts before the current one is not "right" of it, even when it is wider.
    current = TestRect(300, 100, 200, 64)
    candidates = [TestRect(100, 100, 300, 64)]
    AssertEqual(FocusPick(current, candidates, "right"), -1)
    AssertEqual(FocusPick(current, candidates, "left"), 0)
end sub

sub Test_Focus_directions()
    AssertEqual(FocusDirection("left"), "left")
    AssertEqual(FocusDirection("OK"), "")
end sub

' SDK sceneBoundingRect includes a node's children: a focus glow is not its key surface.
' These are independently supplied scene rectangles, not a simulation of native SG rendering.
sub Test_Focus_glowMustNotMoveTheNavigationOrigin()
    node = {
        focusWidth: 86
        focusHeight: 72
        focusBounds: {
            sceneBoundingRect: function() as object
                return { x: 120, y: 600, width: 86, height: 72 }
            end function
        }
        hasField: function(name as string) as boolean
            return m.doesExist(name)
        end function
        sceneBoundingRect: function() as object
            return { x: -8, y: 498, width: 342, height: 328 }
        end function
    }
    rect = FocusRect(node)
    AssertEqual(rect.x, 120, "a glow must not shift the control origin")
    AssertEqual(rect.y, 600, "a glow must not shift the control origin")
    ' B is beside A, J below A, and Continue above the keyboard. Down must select J.
    candidates = [TestRect(216, 600, 86, 72), TestRect(120, 682, 86, 72), TestRect(120, 506, 194, 72)]
    AssertEqual(FocusPick(rect, candidates, "down"), 1)
end sub
