import "pkg:/source/core/SearchGenres.bs"

function TestGenreArt(id as string, role = "backdrop" as string, kind = "item" as string) as object
    width = "1920"
    if role = "poster" then width = "400"
    return { kind: kind, id: id, path: "/v1/metadata/" + kind + "/" + id + "/art/" + role + "?v=" + String(64, "a") + "&w=" + width }
end function

function TestSearchGenre(value as string, total as integer, art = true as boolean) as object
    row = { value: value, label: value, "count": total, covers: [] }
    if art then row.backdrop = TestGenreArt(value)
    return row
end function

function TestSearchGenrePage() as object
    first = TestSearchGenre("Drama", 31)
    first.covers = [TestGenreArt("poster-a", "poster"), TestGenreArt("show-b", "poster", "show")]
    return { revision: "opaque-authorized-revision", genres: [first, TestSearchGenre("Crime", 9, false), TestSearchGenre("Sci-Fi & Fantasy", 17, false)], nextCursor: "opaque/+=" }
end function

sub Test_SearchGenres_preservesServerOrderExactLabelsCountsAndArtlessRows()
    raw = TestSearchGenrePage()
    parsed = ParseSearchGenres(raw)
    AssertTrue(parsed.ok)
    AssertEqual(parsed.revision, "opaque-authorized-revision")
    AssertEqual(parsed.nextCursor, "opaque/+=")
    AssertEqual(parsed.genres.count(), 3)
    AssertEqual(parsed.genres[0].label, "Drama")
    AssertEqual(FieldOf(parsed.genres[0], "count"), 31)
    AssertEqual(parsed.genres[1].backdrop, invalid)
    AssertEqual(parsed.genres[1].covers.count(), 0)
    AssertEqual(parsed.genres[2].value, "Sci-Fi & Fantasy")
    raw.genres[0].label = "changed"
    raw.genres[0].backdrop.path = "https://private.invalid"
    AssertEqual(parsed.genres[0].label, "Drama")
    AssertEqual(parsed.genres[0].backdrop.path, TestGenreArt("Drama").path)
    AssertEqual(SearchGenreTVPrefix(parsed).count(), 1)
    AssertEqual(parsed.genres.count(), 3, "the All genres page retains counted rows without art")
end sub

sub Test_SearchGenres_refusesNullSlotsInvalidCountsDuplicatesAndUnboundedPages()
    for each key in ["revision", "nextCursor"]
        raw = TestSearchGenrePage()
        raw[key] = invalid
        AssertEqual(ParseSearchGenres(raw).ok, false)
        raw[key] = ""
        AssertEqual(ParseSearchGenres(raw).ok, false)
    end for
    for each value in [0, -1, 1.2, "9", 9007199254740992#]
        raw = TestSearchGenrePage()
        raw.genres[0]["count"] = value
        AssertEqual(ParseSearchGenres(raw).ok, false)
    end for
    raw = TestSearchGenrePage()
    raw.genres[0].backdrop = invalid
    AssertEqual(ParseSearchGenres(raw).ok, false)
    raw = TestSearchGenrePage()
    raw.genres[0].covers = invalid
    AssertEqual(ParseSearchGenres(raw).ok, false)
    raw = TestSearchGenrePage()
    raw.genres[0].covers.push(TestGenreArt("third-cover", "poster"))
    AssertEqual(ParseSearchGenres(raw).ok, false)
    raw = TestSearchGenrePage()
    raw.genres[0].covers[1] = raw.genres[0].covers[0]
    AssertEqual(ParseSearchGenres(raw).ok, false)
    raw = TestSearchGenrePage()
    raw.genres[1].value = raw.genres[0].value
    AssertEqual(ParseSearchGenres(raw).ok, false)
    raw = { revision: "r", genres: [] }
    for index = 0 to 50
        raw.genres.push(TestSearchGenre("genre-" + index.toStr(), 1))
    end for
    AssertEqual(ParseSearchGenres(raw).ok, false)
end sub

sub Test_SearchGenres_acceptsOnlyTheExactSelectedSubjectKindRoleAndQuery()
    raw = TestSearchGenrePage()
    expected = TestGenreArt("Drama")
    for each path in ["https://provider.invalid/art", "//provider.invalid/art", "/private/file.jpg", TestGenreArt("another-title").path, TestGenreArt("Drama", "poster").path, TestGenreArt("Drama", "backdrop", "show").path, expected.path + "&token=private", expected.path + "#fragment", expected.path.replace("w=1920", "w=400")]
        raw.genres[0].backdrop.path = path
        AssertEqual(ParseSearchGenres(raw).ok, false)
    end for
    raw.genres[0].backdrop = expected
    raw.genres[0].backdrop.path = "/v1/metadata/item/Drama/art/backdrop?w=1920&v=" + String(64, "a")
    AssertTrue(ParseSearchGenres(raw).ok, "query order is not a new art choice")
    raw.genres[0].backdrop.path = "/v1/metadata/item/Drama/art/backdrop?w=%31%39%32%30&v=" + String(64, "a")
    AssertTrue(ParseSearchGenres(raw).ok, "validate the decoded query, like URLSearchParams")
    raw.secret = "private"
    raw.genres[0].providerUrl = "private"
    raw.genres[0].backdrop.token = "private"
    parsed = ParseSearchGenres(raw)
    AssertTrue(parsed.ok)
    AssertEqual(parsed.secret, invalid)
    AssertEqual(parsed.genres[0].providerUrl, invalid)
    AssertEqual(parsed.genres[0].backdrop.token, invalid)
end sub

sub Test_SearchGenres_opaquePagesYieldOnlyTheDrawnPrefixWithoutRankingOrArtReplacement()
    first = ParseSearchGenres(TestSearchGenrePage())
    window = SearchGenreWindowAppend(SearchGenreWindowNew(), first, "")
    AssertTrue(window.ok)
    AssertEqual(window.window.tiles.count(), 1)
    AssertEqual(window.window.done, false)
    ' The producer's already selected fallback survives; no client reranking is permitted.
    shared = TestSearchGenre("Adventure", 18)
    shared.backdrop = TestGenreArt("producer-chosen-fallback")
    second = ParseSearchGenres({ revision: first.revision, genres: [shared, TestSearchGenre("Animation", 14), TestSearchGenre("Comedy", 12), TestSearchGenre("Action", 10)] })
    completed = SearchGenreWindowAppend(window.window, second, first.nextCursor)
    AssertTrue(completed.ok)
    AssertTrue(completed.window.done)
    AssertEqual(completed.window.tiles.count(), 4)
    AssertEqual(completed.window.tiles[0].value, "Drama")
    AssertEqual(completed.window.tiles[1].value, "Adventure")
    AssertEqual(completed.window.tiles[1].backdrop.id, "producer-chosen-fallback")
    AssertEqual(completed.window.tiles[3].value, "Comedy")
    AssertEqual(window.window.tiles.count(), 1, "append does not reorder the prior window")
    second.revision = "changed-viewer-or-library-revision"
    AssertEqual(SearchGenreWindowAppend(window.window, second, first.nextCursor).code, "stale_continuation")
    AssertEqual(SearchGenreWindowAppend(window.window, first, "wrong-cursor").ok, false)
    AssertEqual(SearchGenreWindowAppend(window.window, first, first.nextCursor).ok, false, "repeating the same cursor refuses replay")
end sub

sub Test_SearchGenres_oldFamilyCannotReadOrPublishUnderTheNewSignIn()
    ctx = TestContext()
    session = TestSessionJson(ctx, "viewer")
    AssertTrue(SessionAccept(ctx, { origin: ctx.base, signIn: "local", pin: TestPin(ctx) }, session).ok)
    binding = ViewerRequestBinding({ origin: ctx.base, viewer: session.viewer, sessionFamilyId: session.sessionFamilyId })
    AssertEqual(ReadSearchGenres(ctx, {}, invalid).error.code, "cancelled")
    AssertEqual(ctx.transport.requests.count(), 0)
    ctx.transport.store = ctx.store
    ctx.transport.section = SessionRecordSection(binding.serverId)
    ctx.transport.mutableBinding = binding
    originalBinding = ParseJson(FormatJson(binding))
    ctx.send = function(request as object) as object
        original = { transport: m.transport, send: TestSend }
        answer = original.send(request)
        record = StoreReadJson(m.transport.store, m.transport.section, "record")
        record["session"].sessionFamilyId = "fam_new_signin"
        StoreWriteJson(m.transport.store, m.transport.section, "record", record)
        m.transport.mutableBinding.sessionFamilyId = "fam_new_signin"
        return answer
    end function
    TestAnswer(ctx, "GET", ctx.base + SearchGenresPath(), 200, TestSearchGenrePage())
    late = ReadSearchGenres(ctx, {}, binding)
    AssertEqual(late.error.code, "cancelled")
    AssertEqual(late.value, invalid)
    AssertEqual(SessionRecord(ctx)["session"].sessionFamilyId, "fam_new_signin")
    AssertEqual(ctx.transport.requests.count(), 1)
    AssertEqual(ReadSearchGenres(ctx, {}, originalBinding).error.code, "cancelled")
    AssertEqual(ctx.transport.requests.count(), 1, "an old continuation cannot use the new family's token")
end sub

sub Test_SearchGenres_readUsesCapturedViewerAndNeverPublishesAfterCancellation()
    ctx = TestContext()
    session = TestSessionJson(ctx, "viewer")
    AssertTrue(SessionAccept(ctx, { origin: ctx.base, signIn: "local", pin: TestPin(ctx) }, session).ok)
    binding = ViewerRequestBinding({ origin: ctx.base, viewer: session.viewer, sessionFamilyId: session.sessionFamilyId })
    path = "/v1/search/genres?limit=4&cursor=opaque%2F%2B%3D"
    TestAnswer(ctx, "GET", ctx.base + path, 200, TestSearchGenrePage())
    answer = ReadSearchGenres(ctx, { limit: 4, cursor: "opaque/+=" }, binding)
    AssertTrue(answer.ok)
    AssertEqual(ctx.transport.requests.count(), 1)
    AssertEqual(ctx.transport.requests[0].headers.Authorization, "Bearer " + session.accessToken)
    AssertEqual(SearchGenresPath(), "/v1/search/genres?limit=50")
    for each limit in [0, -1, 51, 1.2]
        AssertEqual(SearchGenresPath({ limit: limit }), invalid)
    end for
    ctx.searchGenreTask = { cancelled: true }
    AssertEqual(ReadSearchGenres(ctx, {}, binding).error.code, "cancelled")
    AssertEqual(ctx.transport.requests.count(), 1, "cancelled caller sends no second request")
    ctx.searchGenreTask.cancelled = false
    ctx.transport.genreTask = ctx.searchGenreTask
    ctx.send = function(request as object) as object
        original = { transport: m.transport, send: TestSend }
        answer = original.send(request)
        m.transport.genreTask.cancelled = true
        return answer
    end function
    TestAnswer(ctx, "GET", ctx.base + SearchGenresPath(), 200, TestSearchGenrePage())
    late = ReadSearchGenres(ctx, {}, binding)
    AssertEqual(late.error.code, "cancelled")
    AssertEqual(late.value, invalid)
    AssertEqual(ctx.transport.requests.count(), 2, "one bounded read, never an automatic replay")
end sub

function TestSearchGenreCapabilities() as object
    pivot = { id: "video-titles", browsable: true, entityKinds: ["movie", "show"] }
    return { library: { id: "", kind: "" }, pivots: [pivot], resolvedPivot: { id: "video-titles", browsable: true, entityKinds: ["movie", "show"] }, fields: [{ id: "genre", operators: ["equals"] }], sorts: [{ id: "title", directions: ["asc", "desc"] }], surfaces: [{ id: "genre-titles", endpoint: "/v1/browse", membershipField: "genre", filters: ["genre"], sorts: ["title"], paging: "offset" }], queryLimits: { defaultLimit: 50, maximumLimit: 200 } }
end function

function TestSearchGenreTitles() as object
    return { pivot: "video-titles", applied: { query: { field: "genre", operator: "equals", value: "Sci-Fi & Fantasy" }, sort: [{ field: "title", direction: "asc" }], seek: invalid }, entries: [{ id: "show-empty", kind: "show", title: "A show with no episodes" }], pageInfo: { start: 0, total: 2, totalIsLowerBound: false, hasMore: true, nextCursor: "opaque/+value=", revision: "genre-membership-revision" }, positionIndex: [] }
end function

sub Test_SearchGenreDestination_usesCanonicalVideoPivotQueryAndContext()
    body = SearchGenreBrowseRequest("Sci-Fi & Fantasy")
    AssertEqual(FormatJson(body), FormatJson({ pivot: "video-titles", query: { field: "genre", operator: "equals", value: "Sci-Fi & Fantasy" }, sort: [{ field: "title", direction: "asc" }] }))
    AssertEqual(SearchGenreCapabilitiesPath(), "/v1/browse-capabilities?pivot=video-titles")
    path = SearchGenreFacetsPath("genre", "Sci-Fi & Fantasy")
    AssertTrue(Instr(1, path, "/v1/browse/facets?field=genre&pivot=video-titles&limit=200&query=") = 1)
    AssertTrue(Instr(1, path, "Sci-Fi%20%26%20Fantasy") > 0)
    for each value in ["", String(1025, "a"), "Crime" + Chr(0)]
        AssertEqual(SearchGenreBrowseRequest(value), invalid)
    end for
    body = SearchGenreBrowseRequest("Crime", { limit: 20, cursor: "opaque/+value=" })
    AssertEqual(body.cursor, "opaque/+value=")
    AssertEqual(body.limit, 20)
    AssertEqual(SearchGenreBrowseRequest("Crime", { limit: 201 }), invalid)
end sub

sub Test_SearchGenreDestination_refusesMixedPivotsAndUnpublishedSurface()
    AssertTrue(ParseSearchGenreCapabilities(TestSearchGenreCapabilities()).ok)
    raw = TestSearchGenreCapabilities()
    raw.resolvedPivot.entityKinds.push("album")
    AssertEqual(ParseSearchGenreCapabilities(raw).ok, false)
    raw = TestSearchGenreCapabilities()
    raw.resolvedPivot.id = "titles"
    AssertEqual(ParseSearchGenreCapabilities(raw).ok, false)
    raw = TestSearchGenreCapabilities()
    raw.surfaces = []
    AssertEqual(ParseSearchGenreCapabilities(raw).ok, false)
    raw = TestSearchGenreCapabilities()
    raw.surfaces[0].endpoint = "/private"
    AssertEqual(ParseSearchGenreCapabilities(raw).ok, false)
    raw = TestSearchGenreCapabilities()
    raw.fields[0].operators = ["contains"]
    AssertEqual(ParseSearchGenreCapabilities(raw).ok, false)
    raw = TestSearchGenreCapabilities()
    raw.sorts[0].directions = ["desc"]
    AssertEqual(ParseSearchGenreCapabilities(raw).ok, false)
    raw = TestSearchGenreCapabilities()
    raw.library.id = "single-library"
    AssertEqual(ParseSearchGenreCapabilities(raw).ok, false)
end sub

sub Test_SearchGenreDestination_preservesEmptyShowsAndOpaqueContinuation()
    page = ParseSearchGenreTitles(TestSearchGenreTitles(), "Sci-Fi & Fantasy")
    AssertTrue(page.ok)
    AssertEqual(page.entries[0].id, "show-empty")
    AssertEqual(page.entries[0].kind, "show")
    AssertEqual(page.total, 2)
    AssertEqual(page.nextCursor, "opaque/+value=")
    AssertEqual(page.revision, "genre-membership-revision")
    AssertEqual(ParseSearchGenreTitles(TestSearchGenreTitles(), "Crime").ok, false)
    AssertEqual(ParseSearchGenreTitles(TestSearchGenreTitles(), "Sci-Fi & Fantasy", "prior-revision").code, "stale_continuation")
    raw = TestSearchGenreTitles()
    raw.entries[0].kind = "album"
    AssertEqual(ParseSearchGenreTitles(raw, "Sci-Fi & Fantasy").ok, false)
    raw = TestSearchGenreTitles()
    raw.pivot = "titles"
    AssertEqual(ParseSearchGenreTitles(raw, "Sci-Fi & Fantasy").ok, false)
end sub

sub Test_SearchGenreDestination_readsCapabilitiesBeforeExactPostAndFencesRevokedCaller()
    ctx = TestContext()
    session = TestSessionJson(ctx, "viewer")
    AssertTrue(SessionAccept(ctx, { origin: ctx.base, signIn: "local", pin: TestPin(ctx) }, session).ok)
    binding = ViewerRequestBinding({ origin: ctx.base, viewer: session.viewer, sessionFamilyId: session.sessionFamilyId })
    TestAnswer(ctx, "GET", ctx.base + "/v1/browse-capabilities?pivot=video-titles", 200, TestSearchGenreCapabilities())
    TestAnswer(ctx, "POST", ctx.base + "/v1/browse", 200, TestSearchGenreTitles())
    result = ReadSearchGenreTitles(ctx, "Sci-Fi & Fantasy", { limit: 20 }, binding)
    AssertTrue(result.ok)
    AssertEqual(ctx.transport.requests.count(), 2)
    sent = ParseJson(ctx.transport.requests[1].body)
    AssertEqual(sent.pivot, "video-titles")
    AssertEqual(sent.query.value, "Sci-Fi & Fantasy")
    AssertEqual(sent.limit, 20)
    ctx.searchGenreTask = { cancelled: false }
    ctx.transport.genreTask = ctx.searchGenreTask
    ctx.send = function(request as object) as object
        original = { transport: m.transport, send: TestSend }
        answer = original.send(request)
        m.transport.genreTask.cancelled = true
        return answer
    end function
    TestAnswer(ctx, "GET", ctx.base + "/v1/browse-capabilities?pivot=video-titles", 200, TestSearchGenreCapabilities())
    result = ReadSearchGenreTitles(ctx, "Sci-Fi & Fantasy", {}, binding)
    AssertEqual(result.error.code, "cancelled")
    AssertEqual(ctx.transport.requests.count(), 3, "cancellation between capability and page prevents POST")
end sub

sub Test_SearchGenreDestination_keepsRangeRevisionAndRejectsCursorRangeAmbiguity()
    body = SearchGenreBrowseRequest("Drama", { limit: 60, range: { start: 120, revision: "opaque-revision" } })
    AssertEqual(body.range.start, 120)
    AssertEqual(body.range.revision, "opaque-revision")
    AssertEqual(body.query.value, "Drama")
    AssertEqual(SearchGenreBrowseRequest("Drama", { cursor: "opaque", range: { start: 120 } }), invalid)
    AssertEqual(SearchGenreBrowseRequest("Drama", { range: { start: -1 } }), invalid)
    AssertEqual(SearchGenreBrowseRequest("Drama", { range: { start: 0, revision: "" } }), invalid)
end sub

sub Test_SearchGenreDestination_lowerBoundIsNotAMembershipCeiling()
    raw = TestSearchGenreTitles()
    raw.pageInfo.start = 10000
    raw.pageInfo.total = 10000
    raw.pageInfo.totalIsLowerBound = true
    page = ParseSearchGenreTitles(raw, "Sci-Fi & Fantasy", "genre-membership-revision")
    AssertTrue(page.ok)
    AssertEqual(page.start, 10000)
    AssertEqual(page.total, 10002)
    AssertEqual(page.hasMore, true)
    AssertEqual(page.totalIsLowerBound, true)
    AssertEqual(raw.pageInfo.total, 10000, "the original lower-bound response is preserved")
    raw.pageInfo.hasMore = false
    raw.pageInfo.nextCursor = ""
    page = ParseSearchGenreTitles(raw, "Sci-Fi & Fantasy")
    AssertTrue(page.ok)
    AssertEqual(page.total, 10001)
    AssertEqual(page.hasMore, false)
    AssertEqual(page.totalIsLowerBound, false)
end sub

sub Test_SearchGenreDestination_discardsALatePageWhenTheSignInFamilyChanges()
    ctx = TestContext()
    session = TestSessionJson(ctx, "viewer")
    AssertTrue(SessionAccept(ctx, { origin: ctx.base, signIn: "local", pin: TestPin(ctx) }, session).ok)
    binding = ViewerRequestBinding({ origin: ctx.base, viewer: session.viewer, sessionFamilyId: session.sessionFamilyId })
    ctx.transport.store = ctx.store
    ctx.transport.section = SessionRecordSection(binding.serverId)
    ctx.transport.mutableBinding = binding
    ctx.send = function(request as object) as object
        original = { transport: m.transport, send: TestSend }
        answer = original.send(request)
        if request.method = "POST" then
            record = StoreReadJson(m.transport.store, m.transport.section, "record")
            record["session"].sessionFamilyId = "different-family"
            StoreWriteJson(m.transport.store, m.transport.section, "record", record)
            m.transport.mutableBinding.sessionFamilyId = "different-family"
        end if
        return answer
    end function
    TestAnswer(ctx, "GET", ctx.base + "/v1/browse-capabilities?pivot=video-titles", 200, TestSearchGenreCapabilities())
    TestAnswer(ctx, "POST", ctx.base + "/v1/browse", 200, TestSearchGenreTitles())
    result = ReadSearchGenreTitles(ctx, "Sci-Fi & Fantasy", {}, binding)
    AssertEqual(result.error.code, "cancelled")
    AssertEqual(result.value, invalid)
    AssertEqual(ctx.transport.requests.count(), 2)
end sub
